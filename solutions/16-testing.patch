+++ b/backend/tests/SecLab.Api.Tests/Learner/AuthorizationMatrixTests.cs	2026-10-04 21:34:37.124319096 +0200
@@ -0,0 +1,241 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Authorization.Infrastructure;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.AspNetCore.Routing;
+using Microsoft.Extensions.DependencyInjection;
+using Xunit;
+
+namespace SecLab.Api.Tests.Learner;
+
+// Step 16 - the authorization matrix: every route x every kind of caller -> who may do what.
+// The expectations are written down ONCE, in Table, from the requirements (docs 05, 06) - not copied from what the API happens to do.
+// Three layers: (1) the table and the live endpoints are the same set, (2) the table agrees with the endpoint metadata,
+// (3) behaviour: the live API answers every cell of the matrix the way the table says.
+
+/// <summary>What an endpoint demands. The behaviour for each caller follows from this (see <see cref="AuthorizationMatrixTests.Expected"/>).</summary>
+public enum Access
+{
+    Anonymous,      // public on purpose
+    User,           // any signed-in user (JWT) - the default-deny fallback policy
+    Admin,          // role Admin (policy "Admin")
+    OwnerOnly,      // the owner of the object, nobody else (not even an admin)
+    OwnerOrAdmin,   // the owner or an admin
+    StepUp,         // signed in AND a fresh passkey assertion (X-StepUp) - without it: 403 for everybody
+    ApiKeyRead, ApiKeyWrite, ApiKeyAdmin,   // an API key of at least that level; JWT users are not accepted here
+}
+
+public enum Caller { Anonymous, Owner, Other, Admin, KeyRead, KeyWrite, KeyAdmin }
+public enum Outcome { Allowed, Unauthorized, Forbidden }
+
+public sealed class MatrixFixture : IDisposable
+{
+    readonly EnvScope _env;
+    public WebApplicationFactory<Program> Factory { get; } = new();
+    public Harness H { get; }
+    public Harness.Person Owner { get; }
+    public Harness.Person Other { get; }
+    public Harness.Person Admin { get; }
+    public Dictionary<Caller, string> Keys { get; } = new();
+
+    public MatrixFixture()
+    {
+        // 231 requests from one address in one minute would trip the limiters; the limiters have their own tests (API4).
+        _env = new EnvScope(("RateLimiting__Anonymous", "1000000"), ("RateLimiting__User", "1000000"), ("RateLimiting__Login", "1000000"),
+            ("RateLimiting__ApiKeyRead", "1000000"), ("RateLimiting__ApiKeyWrite", "1000000"), ("RateLimiting__ApiKeyAdmin", "1000000"));
+        H = new Harness(Factory);
+        Owner = H.NewPerson(); Other = H.NewPerson(); Admin = H.NewPerson("Admin");
+        Keys[Caller.KeyRead] = CreateKey(Owner, "read");
+        Keys[Caller.KeyWrite] = CreateKey(Owner, "write");
+        Keys[Caller.KeyAdmin] = CreateKey(Admin, "admin");
+    }
+
+    public string CreateKey(Harness.Person who, string level)
+    {
+        var res = who.Http.PostAsJsonAsync("/api/keys", new { name = "matrix", level }).GetAwaiter().GetResult();
+        Assert.Equal(HttpStatusCode.Created, res.StatusCode);
+        return JsonDocument.Parse(res.Content.ReadAsStringAsync().GetAwaiter().GetResult()).RootElement.GetProperty("apiKey").GetString()!;
+    }
+
+    public void Dispose() { H.Dispose(); Factory.Dispose(); _env.Dispose(); }
+}
+
+[Trait("Step", "16")]
+[Trait("Kind", "Matrix")]
+public class AuthorizationMatrixTests(MatrixFixture fx) : IClassFixture<MatrixFixture>
+{
+    // ---------------- the table: the one place that says who may do what ----------------
+    internal static readonly Dictionary<string, Access> Table = new()
+    {
+        ["ANY /health/live"] = Access.Anonymous,
+        ["ANY /health/ready"] = Access.Anonymous,
+        ["POST /api/auth/login"] = Access.Anonymous,
+        ["POST /api/auth/register"] = Access.Anonymous,
+
+        ["GET /api/me"] = Access.User,
+        ["DELETE /api/me"] = Access.StepUp,
+        ["GET /api/users/{id}"] = Access.User,                    // everybody sees *a* profile; how much is a contract question
+        ["PUT /api/users/{id}"] = Access.OwnerOnly,
+        ["GET /api/users/{id}/friends"] = Access.OwnerOrAdmin,
+        ["GET /api/users/{id}/likes"] = Access.OwnerOrAdmin,
+        ["POST /api/users/{id}/avatar"] = Access.OwnerOnly,
+
+        ["GET /api/blogs"] = Access.User,
+        ["GET /api/blogs/search"] = Access.User,
+        ["POST /api/blogs"] = Access.User,
+        ["PUT /api/blogs/{id}"] = Access.OwnerOnly,
+        ["DELETE /api/blogs/{id}"] = Access.OwnerOrAdmin,
+        ["POST /api/blogs/{id}/like"] = Access.User,
+        ["DELETE /api/blogs/{id}/like"] = Access.User,
+        ["GET /api/timeline"] = Access.User,
+
+        ["GET /api/admin/users"] = Access.Admin,
+        ["PUT /api/admin/users/{id}/role"] = Access.Admin,
+        ["GET /api/debug/crash"] = Access.Admin,
+
+        ["GET /api/keys"] = Access.User,
+        ["POST /api/keys"] = Access.User,
+        ["DELETE /api/keys/{id}"] = Access.OwnerOrAdmin,
+        ["GET /api/partner/blogs"] = Access.ApiKeyRead,
+        ["POST /api/partner/blogs"] = Access.ApiKeyWrite,
+        ["DELETE /api/partner/blogs/{id}"] = Access.ApiKeyAdmin,
+
+        ["GET /api/passkeys"] = Access.User,
+        ["POST /api/passkeys/register/options"] = Access.User,
+        ["POST /api/passkeys/register/complete"] = Access.User,
+        ["POST /api/passkeys/assert/options"] = Access.User,
+        ["POST /api/passkeys/assert/complete"] = Access.User,
+        ["POST /api/tools/link-preview"] = Access.User,
+    };
+
+    /// <summary>These are meant to fail on bad input or on purpose; every other "allowed" answer must not be a 5xx.</summary>
+    static readonly HashSet<string> MayCrash = ["GET /api/debug/crash"];
+
+    /// <summary>The login endpoint answers 401 itself ("wrong credentials") - that is the handler talking, not the authentication middleware.</summary>
+    static readonly HashSet<string> ItsOwn401 = ["POST /api/auth/login"];
+
+    // ---------------- discovery: the live endpoint set ----------------
+    static string Normalize(string pattern) => System.Text.RegularExpressions.Regex.Replace("/" + pattern.Trim('/'), @"\{(\w+):\w+\}", "{$1}");
+
+    internal static List<(string Key, RouteEndpoint Endpoint)> Live(IServiceProvider sp) =>
+        sp.GetRequiredService<EndpointDataSource>().Endpoints.OfType<RouteEndpoint>()
+            .SelectMany(e => (e.Metadata.GetMetadata<HttpMethodMetadata>()?.HttpMethods ?? ["ANY"]).Select(m => ($"{m} {Normalize(e.RoutePattern.RawText ?? "")}", e)))
+            .DistinctBy(x => x.Item1).OrderBy(x => x.Item1).ToList();
+
+    // ---------------- layer 1: the inventory ----------------
+    [Fact]
+    public void Every_endpoint_has_an_entry_in_the_table_and_the_table_has_no_stale_entries()
+    {
+        var live = Live(fx.H.Services).Select(x => x.Key).ToHashSet();
+        Assert.Empty(live.Except(Table.Keys));      // a new route: decide who may call it, add it to the table AND to the behaviour below
+        Assert.Empty(Table.Keys.Except(live));      // a removed or renamed route: delete the entry
+    }
+
+    // ---------------- layer 2: the table against the metadata ----------------
+    [Fact]
+    public void Declared_access_agrees_with_what_the_endpoint_says_about_itself()
+    {
+        foreach (var (key, ep) in Live(fx.H.Services))
+        {
+            var policies = ep.Metadata.OfType<IAuthorizeData>().Select(a => a.Policy).Where(p => p is not null).ToList();
+            var declared = Table[key];
+            if (ep.Metadata.GetMetadata<IAllowAnonymous>() is not null) Assert.True(declared == Access.Anonymous, $"{key} is AllowAnonymous but the table says {declared}");
+            else if (policies.Contains("Admin")) Assert.True(declared == Access.Admin, $"{key} has policy Admin but the table says {declared}");
+            else if (policies.FirstOrDefault(p => p!.StartsWith("ApiKey:")) is { } p)
+                Assert.True(declared.ToString() == "ApiKey" + char.ToUpper(p["ApiKey:".Length]) + p["ApiKey:".Length..][1..], $"{key} has policy {p} but the table says {declared}");
+            else   // no explicit decision: the fallback policy governs - and that must be "signed-in user"
+                Assert.True(declared is Access.User or Access.OwnerOnly or Access.OwnerOrAdmin or Access.StepUp, $"{key} relies on the fallback policy but the table says {declared}");
+        }
+    }
+
+    [Fact]
+    public async Task The_fallback_policy_denies_anonymous_callers()
+    {
+        var fallback = await fx.H.Services.GetRequiredService<IAuthorizationPolicyProvider>().GetFallbackPolicyAsync();
+        Assert.NotNull(fallback);
+        Assert.Contains(fallback!.Requirements, r => r is DenyAnonymousAuthorizationRequirement);
+    }
+
+    // ---------------- layer 3: behaviour ----------------
+    internal static Outcome Expected(Access access, Caller caller)
+    {
+        var jwt = caller is Caller.Owner or Caller.Other or Caller.Admin;
+        return access switch
+        {
+            Access.Anonymous => Outcome.Allowed,
+            Access.User => jwt ? Outcome.Allowed : Outcome.Unauthorized,
+            Access.Admin => caller == Caller.Admin ? Outcome.Allowed : jwt ? Outcome.Forbidden : Outcome.Unauthorized,
+            Access.OwnerOnly => caller == Caller.Owner ? Outcome.Allowed : jwt ? Outcome.Forbidden : Outcome.Unauthorized,
+            Access.OwnerOrAdmin => caller is Caller.Owner or Caller.Admin ? Outcome.Allowed : jwt ? Outcome.Forbidden : Outcome.Unauthorized,
+            Access.StepUp => jwt ? Outcome.Forbidden : Outcome.Unauthorized,
+            Access.ApiKeyRead or Access.ApiKeyWrite or Access.ApiKeyAdmin =>
+                !caller.ToString().StartsWith("Key") ? Outcome.Unauthorized
+                : Rank(caller) >= Rank(access) ? Outcome.Allowed : Outcome.Forbidden,
+            _ => throw new ArgumentOutOfRangeException(nameof(access)),
+        };
+    }
+    static int Rank(Caller c) => c switch { Caller.KeyRead => 1, Caller.KeyWrite => 2, Caller.KeyAdmin => 3, _ => 0 };
+    static int Rank(Access a) => a switch { Access.ApiKeyRead => 1, Access.ApiKeyWrite => 2, _ => 3 };
+
+    public static IEnumerable<object[]> Cells() =>
+        from key in Table.Keys.Order() from caller in Enum.GetValues<Caller>() select new object[] { key, caller };
+
+    [Theory]
+    [MemberData(nameof(Cells))]
+    public async Task Every_route_answers_every_caller_as_the_table_says(string route, Caller caller)
+    {
+        var (method, pattern) = (route.Split(' ')[0], route.Split(' ')[1]);
+        var expected = Expected(Table[route], caller);
+
+        // arrange: fresh objects owned by Owner, so destructive routes can be called once per cell
+        var path = pattern;
+        if (pattern.Contains("{id}"))
+        {
+            var id = pattern switch
+            {
+                var p when p.StartsWith("/api/users/") => fx.Owner.Id,
+                var p when p.StartsWith("/api/admin/users/") => fx.Other.Id,
+                var p when p.StartsWith("/api/keys/") => await NewKeyId(),
+                _ => await NewBlogId(),
+            };
+            path = pattern.Replace("{id}", id.ToString());
+        }
+        var req = new HttpRequestMessage(method == "ANY" ? HttpMethod.Get : new HttpMethod(method), path);
+        if (method is "POST" or "PUT")
+            req.Content = pattern.EndsWith("/avatar")
+                ? new MultipartFormDataContent { { new ByteArrayContent([0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A, 0, 0, 0, 0]), "file", "a.png" } }
+                : JsonContent.Create(new { });
+        HttpClient client = caller switch
+        {
+            Caller.Owner => fx.Owner.Http, Caller.Other => fx.Other.Http, Caller.Admin => fx.Admin.Http,
+            _ => fx.H.Anonymous(),
+        };
+        if (fx.Keys.TryGetValue(caller, out var key)) req.Headers.Add("X-Api-Key", key);
+
+        var res = await client.SendAsync(req);
+        var status = (int)res.StatusCode;
+        if (status == 200 && pattern.EndsWith("/avatar"))     // the upload really stored a file: do not leave it in the working tree
+            File.Delete(Repo.Path_("backend/src/SecLab.Api/wwwroot" + JsonDocument.Parse(await res.Content.ReadAsStringAsync()).RootElement.GetProperty("avatarUrl").GetString()));
+
+        var actual = status switch { 401 when !ItsOwn401.Contains(route) => Outcome.Unauthorized, 403 => Outcome.Forbidden, _ => Outcome.Allowed };
+        Assert.True(actual == expected, $"{caller} {route}: expected {expected}, got {status}");
+        if (actual == Outcome.Allowed && !MayCrash.Contains(route)) Assert.True(status < 500, $"{caller} {route}: server error {status}");
+    }
+
+    async Task<int> NewBlogId()
+    {
+        var res = await fx.Owner.Http.PostAsJsonAsync("/api/blogs", new { title = "matrix", body = "<p>x</p>" });
+        Assert.Equal(HttpStatusCode.Created, res.StatusCode);
+        return JsonDocument.Parse(await res.Content.ReadAsStringAsync()).RootElement.GetProperty("id").GetInt32();
+    }
+
+    async Task<int> NewKeyId()
+    {
+        var res = await fx.Owner.Http.PostAsJsonAsync("/api/keys", new { name = "matrix-delete-me", level = "read" });
+        Assert.Equal(HttpStatusCode.Created, res.StatusCode);
+        return JsonDocument.Parse(await res.Content.ReadAsStringAsync()).RootElement.GetProperty("id").GetInt32();
+    }
+}
