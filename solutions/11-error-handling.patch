+export class ApiError extends Error {
+  status: number
+  traceId?: string
+  errors?: Record<string, string[]>
+  constructor(status: number, message: string, traceId?: string, errors?: Record<string, string[]>) {
+    super(message)
+    this.status = status; this.traceId = traceId; this.errors = errors
+  }
+}
+
+// Servers answer with RFC 9457 problem details. Show the human part, keep the trace id so support can find the log line.
+async function toApiError(res: Response): Promise<ApiError> {
+  let body: { title?: string; errors?: Record<string, string[]>; traceId?: string } = {}
+  try { body = await res.json() } catch { /* not JSON: fall through */ }
+  const fields = body.errors ? Object.values(body.errors).flat().join(' ') : ''
+  const ref = body.traceId ?? res.headers.get('X-Trace-Id') ?? undefined
+  return new ApiError(res.status, `${body.title ?? res.statusText}${fields ? ' ' + fields : ''}${ref ? ` (ref ${ref})` : ''}`, ref, body.errors)
+}
