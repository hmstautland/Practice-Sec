+
+    // ================= API7 Server Side Request Forgery =================
+
+    [Theory]
+    [InlineData("http://example.com/")]                                    // not https
+    [InlineData("https://127.0.0.1/")]                                     // loopback literal
+    [InlineData("https://169.254.169.254/latest/meta-data/")]              // cloud metadata
+    [InlineData("https://[::1]/")]
+    [InlineData("https://example.com@evil.example/")]                     // user-info trick
+    [InlineData("https://evil.example/")]                                  // not on the allow-list
+    [InlineData("https://example.com.evil.example/")]                      // suffix trick
+    [InlineData("https://example.com:8443/")]                              // other port
+    [InlineData("file:///etc/passwd")]
+    [InlineData("gopher://example.com/")]
+    [InlineData("")]
+    [OwaspApi("API7")]
+    public async Task The_link_preview_refuses_urls_that_are_not_on_the_allow_list(string url)
+    {
+        var p = Start().NewPerson();
+        var res = await p.Http.PostAsJsonAsync("/api/tools/link-preview", new { url });
+        Assert.Equal(HttpStatusCode.BadRequest, res.StatusCode);        // refused before any connection is made
+    }
+
+    // ================= API8 Security Misconfiguration =================
+
+    [Fact]
+    [OwaspApi("API8")]
+    public async Task Every_kind_of_response_carries_the_defensive_headers_and_no_server_banner()
+    {
+        var h = Start();
+        var (p, admin) = (h.NewPerson(), h.NewPerson("Admin"));
+        var responses = new[]
+        {
+            await p.Http.GetAsync("/api/me"),                                  // 200
+            await h.Anonymous().GetAsync("/api/me"),                           // 401
+            await p.Http.GetAsync("/api/admin/users"),                         // 403
+            await p.Http.GetAsync("/api/nope"),                                // 404
+            await admin.Http.GetAsync("/api/debug/crash"),                     // 500
+        };
+        foreach (var r in responses)
+        {
+            Assert.Equal("nosniff", string.Join(",", r.Headers.GetValues("X-Content-Type-Options")));
+            Assert.Contains("frame-ancestors 'none'", string.Join(",", r.Headers.GetValues("Content-Security-Policy")));
+            Assert.Contains("no-store", r.Headers.CacheControl?.ToString());
+            foreach (var banner in new[] { "Server", "X-Powered-By", "X-AspNet-Version" }) Assert.False(r.Headers.Contains(banner), banner);
+        }
+    }
+
+    [Theory]
+    [InlineData("https://evil.example", false)]
+    [InlineData("https://localhost:5173.evil.example", false)]
+    [InlineData("null", false)]
+    [InlineData("https://localhost:5173", true)]
+    [OwaspApi("API8")]
+    public async Task Cross_origin_access_is_granted_to_the_front_end_origin_only(string origin, bool allowed)
+    {
+        var h = Start();
+        var req = new HttpRequestMessage(HttpMethod.Options, "/api/blogs");
+        req.Headers.Add("Origin", origin); req.Headers.Add("Access-Control-Request-Method", "GET");
+        var res = await h.Anonymous().SendAsync(req);
+        Assert.Equal(allowed, res.Headers.Contains("Access-Control-Allow-Origin"));
+        if (allowed) Assert.Equal(origin, res.Headers.GetValues("Access-Control-Allow-Origin").Single());
+    }
+
+    [Fact]
+    [OwaspApi("API8")]
+    public async Task A_crash_tells_the_caller_nothing_about_the_inside()
+    {
+        var admin = Start().NewPerson("Admin");
+        var res = await admin.Http.GetAsync("/api/debug/crash");
+        var text = await res.Content.ReadAsStringAsync();
+        Assert.Equal(HttpStatusCode.InternalServerError, res.StatusCode);
+        foreach (var secret in new[] { "Boom", "Server=", "User Id", "InvalidOperationException", " at SecLab", "StackTrace" }) Assert.DoesNotContain(secret, text);
+    }
+
+    // ================= API9 Improper Inventory Management =================
+
+    [Fact]
+    [OwaspApi("API9")]
+    public async Task Old_versions_announce_their_retirement_and_unknown_versions_are_refused()
+    {
+        var p = Start().NewPerson();
+        var v1 = await p.Http.GetAsync("/api/blogs");                       // default = v1 = deprecated
+        Assert.True(v1.Headers.Contains("Deprecation"));
+        Assert.True(v1.Headers.Contains("api-supported-versions"));
+        Assert.Equal(HttpStatusCode.BadRequest, (await p.Http.GetAsync("/api/blogs?api-version=9.9")).StatusCode);
+        Assert.False((await p.Http.GetAsync("/api/blogs?api-version=2.0")).Headers.Contains("Deprecation"));
+    }
+}
