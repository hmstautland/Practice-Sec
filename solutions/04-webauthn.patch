diff --color -ruN -x bin -x obj -x dist -x node_modules -x certs -x '*.log' mid04/backend/src/SecLab.Api/Endpoints/Passkeys.cs sol04/backend/src/SecLab.Api/Endpoints/Passkeys.cs
--- a/backend/src/SecLab.Api/Endpoints/Passkeys.cs	1970-01-01 01:00:00.000000000 +0100
+++ b/backend/src/SecLab.Api/Endpoints/Passkeys.cs	2026-09-30 11:13:53.041372305 +0200
@@ -0,0 +1,126 @@
+using System.Security.Cryptography;
+using Fido2NetLib;
+using Fido2NetLib.Objects;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Caching.Memory;
+using SecLab.Api.Data;
+using SecLab.Api.Models;
+
+namespace SecLab.Api.Endpoints;
+
+// WebAuthn used for step-up: a signed-in user proves presence + verification with a passkey
+// and receives a short-lived, single-use token that sensitive endpoints demand in X-StepUp.
+public static class Passkeys
+{
+    static readonly TimeSpan CeremonyLifetime = TimeSpan.FromMinutes(5);
+    static string Key(string kind, int userId) => $"webauthn:{kind}:{userId}";
+
+    public static void Map(RouteGroupBuilder api)
+    {
+        var g = api.MapGroup("/passkeys");
+
+        g.MapPost("/register/options", async (HttpContext ctx, AppDbContext db, IFido2 fido2, IMemoryCache cache) =>
+        {
+            if (await Api.CurrentUserId(ctx, db) is not { } uid) return Results.Unauthorized();
+            var user = await db.Users.FirstAsync(u => u.Id == uid);
+            var existing = await db.Passkeys.Where(p => p.UserId == uid).ToListAsync();
+            var handle = existing.FirstOrDefault()?.UserHandle ?? RandomNumberGenerator.GetBytes(16);
+
+            var options = fido2.RequestNewCredential(new RequestNewCredentialParams
+            {
+                User = new Fido2User { Id = handle, Name = user.Username, DisplayName = user.DisplayName },
+                ExcludeCredentials = existing.Select(p => new PublicKeyCredentialDescriptor(p.CredentialId)).ToList(),
+                AuthenticatorSelection = new AuthenticatorSelection { ResidentKey = ResidentKeyRequirement.Preferred, UserVerification = UserVerificationRequirement.Required },
+                AttestationPreference = AttestationConveyancePreference.None,
+            });
+
+            cache.Set(Key("reg", uid), options.ToJson(), CeremonyLifetime);
+            return Results.Content(options.ToJson(), "application/json");
+        });
+
+        g.MapPost("/register/complete", async (AuthenticatorAttestationRawResponse response, HttpContext ctx, AppDbContext db, IFido2 fido2, IMemoryCache cache) =>
+        {
+            if (await Api.CurrentUserId(ctx, db) is not { } uid) return Results.Unauthorized();
+            // Single use: take the challenge out of the cache *before* verifying anything.
+            if (!cache.TryGetValue(Key("reg", uid), out string? json)) return Results.BadRequest(new { error = "No registration in progress" });
+            cache.Remove(Key("reg", uid));
+            var options = CredentialCreateOptions.FromJson(json!);
+
+            try
+            {
+                var cred = await fido2.MakeNewCredentialAsync(new MakeNewCredentialParams
+                {
+                    AttestationResponse = response,
+                    OriginalOptions = options,
+                    IsCredentialIdUniqueToUserCallback = async (args, ct) => !await db.Passkeys.AnyAsync(p => p.CredentialId == args.CredentialId, ct),
+                });
+                db.Passkeys.Add(new Passkey { UserId = uid, CredentialId = cred.Id, PublicKey = cred.PublicKey, SignCount = cred.SignCount, UserHandle = options.User.Id });
+                await db.SaveChangesAsync();
+                return Results.Ok(new { id = Convert.ToBase64String(cred.Id) });
+            }
+            catch (Fido2VerificationException)
+            {
+                return Results.BadRequest(new { error = "Passkey registration failed" });
+            }
+        });
+
+        g.MapPost("/assert/options", async (HttpContext ctx, AppDbContext db, IFido2 fido2, IMemoryCache cache) =>
+        {
+            if (await Api.CurrentUserId(ctx, db) is not { } uid) return Results.Unauthorized();
+            var keys = await db.Passkeys.Where(p => p.UserId == uid).Select(p => new PublicKeyCredentialDescriptor(p.CredentialId)).ToListAsync();
+            if (keys.Count == 0) return Results.BadRequest(new { error = "Register a passkey first" });
+
+            var options = fido2.GetAssertionOptions(new GetAssertionOptionsParams { AllowedCredentials = keys, UserVerification = UserVerificationRequirement.Required });
+            cache.Set(Key("assert", uid), options.ToJson(), CeremonyLifetime);
+            return Results.Content(options.ToJson(), "application/json");
+        });
+
+        g.MapPost("/assert/complete", async (AuthenticatorAssertionRawResponse response, HttpContext ctx, AppDbContext db, IFido2 fido2, IMemoryCache cache) =>
+        {
+            if (await Api.CurrentUserId(ctx, db) is not { } uid) return Results.Unauthorized();
+            if (!cache.TryGetValue(Key("assert", uid), out string? json)) return Results.BadRequest(new { error = "No assertion in progress" });
+            cache.Remove(Key("assert", uid));
+            var options = AssertionOptions.FromJson(json!);
+
+            // The credential must exist *and belong to the caller*.
+            var stored = await db.Passkeys.FirstOrDefaultAsync(p => p.UserId == uid && p.CredentialId == response.RawId);
+            if (stored is null) return Results.BadRequest(new { error = "Unknown credential" });
+
+            try
+            {
+                var result = await fido2.MakeAssertionAsync(new MakeAssertionParams
+                {
+                    AssertionResponse = response,
+                    OriginalOptions = options,
+                    StoredPublicKey = stored.PublicKey,
+                    StoredSignatureCounter = stored.SignCount,
+                    IsUserHandleOwnerOfCredentialIdCallback = (args, ct) => Task.FromResult(args.UserHandle is not null && args.UserHandle.SequenceEqual(stored.UserHandle)),
+                });
+                stored.SignCount = result.SignCount;           // a value that does not increase is rejected by the library
+                await db.SaveChangesAsync();
+            }
+            catch (Fido2VerificationException)
+            {
+                return Results.BadRequest(new { error = "Passkey assertion failed" });
+            }
+
+            var token = Convert.ToBase64String(RandomNumberGenerator.GetBytes(32));
+            cache.Set($"stepup:{token}", ctx.User.FindFirst("preferred_username")!.Value, CeremonyLifetime);
+            return Results.Ok(new { stepUpToken = token, expiresIn = (int)CeremonyLifetime.TotalSeconds });
+        });
+
+        g.MapGet("/", async (HttpContext ctx, AppDbContext db) =>
+            await Api.CurrentUserId(ctx, db) is { } uid
+                ? Results.Ok(await db.Passkeys.Where(p => p.UserId == uid).Select(p => new { p.Id, p.Name, p.CreatedAt }).ToListAsync())
+                : Results.Unauthorized());
+    }
+
+    /// <summary>Validates the X-StepUp header for this user and burns the token (single use).</summary>
+    public static bool ConsumeStepUp(HttpContext ctx, IMemoryCache cache, string username)
+    {
+        var token = ctx.Request.Headers["X-StepUp"].ToString();
+        if (string.IsNullOrEmpty(token) || !cache.TryGetValue($"stepup:{token}", out string? owner) || owner != username) return false;
+        cache.Remove($"stepup:{token}");
+        return true;
+    }
+}
