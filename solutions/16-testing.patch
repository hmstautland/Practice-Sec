+    public void Active_content_is_removed(string html)
+    {
+        var clean = _sanitizer.Clean(html);
+        foreach (var bad in new[] { "<script", "onerror", "onload", "onclick", "javascript:", "<iframe", "<svg", "<img", "style=", "data:" }) Assert.DoesNotContain(bad, clean, StringComparison.OrdinalIgnoreCase);
