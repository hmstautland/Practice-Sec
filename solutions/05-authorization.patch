+++ b/backend/src/SecLab.Api/Authorization/LocalUserClaims.cs	2026-09-30 11:17:50.090432740 +0200
@@ -0,0 +1,31 @@
+using System.Security.Claims;
+using Microsoft.AspNetCore.Authentication;
+using Microsoft.EntityFrameworkCore;
+using SecLab.Api.Data;
+
+namespace SecLab.Api.Authorization;
+
+/// <summary>
+/// The IdP proves *who* the caller is; what they may do is decided here, from our own database.
+/// Adds the local user id and the local role to the validated principal. Runs on every request and must be idempotent.
+/// </summary>
+public class LocalUserClaims(AppDbContext db) : IClaimsTransformation
+{
+    public const string LocalUserId = "local_user_id";
+
+    public async Task<ClaimsPrincipal> TransformAsync(ClaimsPrincipal principal)
+    {
+        if (principal.Identity is not ClaimsIdentity identity || !identity.IsAuthenticated || identity.HasClaim(c => c.Type == LocalUserId))
+            return principal;
+        var username = principal.FindFirst("preferred_username")?.Value;
+        if (string.IsNullOrEmpty(username)) return principal;
+
+        var user = await db.Users.Where(u => u.Username == username).Select(u => new { u.Id, u.Role }).FirstOrDefaultAsync();
+        if (user is null) return principal;
+
+        var clone = new ClaimsIdentity(identity);            // never mutate the identity the handler cached
+        clone.AddClaim(new Claim(LocalUserId, user.Id.ToString()));
+        clone.AddClaim(new Claim(ClaimTypes.Role, user.Role));
+        return new ClaimsPrincipal(clone);
+    }
+}
