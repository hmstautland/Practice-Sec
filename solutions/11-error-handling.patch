--- a/backend/src/SecLab.Api/Errors/Problems.cs	1970-01-01 01:00:00.000000000 +0100
+++ b/backend/src/SecLab.Api/Errors/Problems.cs	2026-09-30 12:00:31.726729922 +0200
@@ -0,0 +1,25 @@
+using Microsoft.AspNetCore.Mvc;
+
+namespace SecLab.Api.Errors;
+
+/// <summary>
+/// Use this instead of Results.Problem(): it goes through IProblemDetailsService, so the trace id, X-Trace-Id and
+/// no-store headers are added exactly as for every other error.
+/// </summary>
+public static class Problems
+{
+    public static IResult Create(int status, string title) => new ProblemResult(status, title);
+
+    sealed class ProblemResult(int status, string title) : IResult
+    {
+        public async Task ExecuteAsync(HttpContext ctx)
+        {
+            ctx.Response.StatusCode = status;
+            await ctx.RequestServices.GetRequiredService<IProblemDetailsService>().TryWriteAsync(new ProblemDetailsContext
+            {
+                HttpContext = ctx,
+                ProblemDetails = new ProblemDetails { Status = status, Title = title },
+            });
+        }
+    }
+}
