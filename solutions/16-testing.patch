+    // ---------- column encryption ----------
+    static EncryptedStringConverter Converter(IDataProtectionProvider p, string purpose = "SecLab.Users.PersonalData.v1") => new(p.CreateProtector(purpose));
+    static string Protect(EncryptedStringConverter c, string plain) => (string)c.ConvertToProvider(plain)!;
+    static string Unprotect(EncryptedStringConverter c, string stored) => (string)c.ConvertFromProvider(stored)!;
+
+    [Fact]
+    public void Encrypted_values_round_trip_but_do_not_contain_the_plaintext_and_differ_every_time()
+    {
+        var c = Converter(new EphemeralDataProtectionProvider());
+        var a = Protect(c, "+47 900 00 000"); var b = Protect(c, "+47 900 00 000");
+        Assert.NotEqual(a, b);                                  // randomised: equal plaintexts are not visible as equal
+        Assert.DoesNotContain("900", a);
+        Assert.True(a.Length > "+47 900 00 000".Length * 2);
+        Assert.Equal("+47 900 00 000", Unprotect(c, a));
+        Assert.Equal("", Unprotect(c, Protect(c, "")));
+    }
+
+    [Fact]
+    public void Ciphertext_cannot_be_opened_with_another_purpose_another_key_ring_or_after_tampering()
+    {
+        var ring = new EphemeralDataProtectionProvider();
+        var stored = Protect(Converter(ring), "secret address");
+        Assert.ThrowsAny<System.Security.Cryptography.CryptographicException>(() => Unprotect(Converter(ring, "SecLab.Something.Else"), stored));
+        Assert.ThrowsAny<System.Security.Cryptography.CryptographicException>(() => Unprotect(Converter(new EphemeralDataProtectionProvider()), stored));
+        var tampered = stored[..^4] + (stored.EndsWith("AAAA") ? "BBBB" : "AAAA");
+        Assert.ThrowsAny<System.Security.Cryptography.CryptographicException>(() => Unprotect(Converter(ring), tampered));
+        Assert.ThrowsAny<Exception>(() => Unprotect(Converter(ring), "plaintext that was never encrypted"));
+    }
