diff --color --color -ruN -x bin -x obj -x dist -x node_modules -x certs -x '*.log' -x '*.png' -x .env mid17/backend/src/SecLab.Gateway/Bff/BffExtensions.cs sol17/backend/src/SecLab.Gateway/Bff/BffExtensions.cs
--- a/backend/src/SecLab.Gateway/Bff/BffExtensions.cs	1970-01-01 01:00:00.000000000 +0100
+++ b/backend/src/SecLab.Gateway/Bff/BffExtensions.cs	2026-10-04 22:18:47.742540275 +0200
@@ -0,0 +1,170 @@
+using Microsoft.AspNetCore.DataProtection;
+using Microsoft.AspNetCore.Authentication;
+using Microsoft.AspNetCore.Authentication.Cookies;
+using Microsoft.AspNetCore.Authentication.OpenIdConnect;
+using Microsoft.Extensions.DependencyInjection.Extensions;
+using Microsoft.IdentityModel.Protocols.OpenIdConnect;
+
+namespace SecLab.Gateway.Bff;
+
+public static class BffExtensions
+{
+    public static void AddBff(this WebApplicationBuilder builder)
+    {
+        var settings = BffSettings.From(builder.Configuration);
+        var services = builder.Services;
+        services.TryAddSingleton(TimeProvider.System);                     // tests replace it: every time decision below goes through this provider
+        services.AddSingleton(settings);
+        services.AddSingleton<SessionStore>();
+        services.AddSingleton<SessionTokens>();
+        services.AddDataProtection().SetApplicationName("SecLab.Gateway");
+
+        services.AddAuthentication()
+            .AddCookie(BffDefaults.CookieScheme, o =>
+            {
+                o.Cookie.Name = BffDefaults.CookieName;
+                o.Cookie.HttpOnly = true;                                   // not readable by scripts: an XSS cannot copy it out
+                o.Cookie.SecurePolicy = CookieSecurePolicy.Always;
+                o.Cookie.SameSite = SameSiteMode.Strict;                    // not sent on requests started by other sites
+                o.Cookie.Path = "/";
+                o.ExpireTimeSpan = settings.SessionLifetime;
+                o.SlidingExpiration = false;                                // the server-side store tracks idle time; the cookie is never re-issued
+                o.Events.OnRedirectToLogin = ctx => { ctx.Response.StatusCode = StatusCodes.Status401Unauthorized; return Task.CompletedTask; };       // an API answers, it does not redirect
+                o.Events.OnRedirectToAccessDenied = ctx => { ctx.Response.StatusCode = StatusCodes.Status403Forbidden; return Task.CompletedTask; };
+            })
+            .AddOpenIdConnect(BffDefaults.OidcScheme, o =>
+            {
+                o.SignInScheme = BffDefaults.CookieScheme;
+                o.Authority = settings.Authority;
+                o.ClientId = settings.ClientId;
+                o.ClientSecret = settings.ClientSecret;                     // confidential client: the secret is only ever sent to the token endpoint, server to server
+                o.ResponseType = OpenIdConnectResponseType.Code;
+                o.ResponseMode = OpenIdConnectResponseMode.Query;
+                o.UsePkce = true;
+                o.CallbackPath = BffDefaults.CallbackPath;
+                o.Scope.Clear();
+                foreach (var scope in new[] { "openid", "profile", "email" }) o.Scope.Add(scope);
+                o.SaveTokens = true;                                        // into the ticket; SessionStore moves them to server memory
+                o.GetClaimsFromUserInfoEndpoint = false;
+                o.MapInboundClaims = false;
+                o.RequireHttpsMetadata = !builder.Environment.IsDevelopment();   // plain HTTP only for the dev Keycloak, as in step 03
+                o.BackchannelTimeout = TimeSpan.FromSeconds(10);
+                o.TokenValidationParameters.NameClaimType = "preferred_username";
+                o.TokenValidationParameters.ClockSkew = TimeSpan.FromSeconds(30);
+                // The correlation / nonce cookies must survive the redirect back from the IdP (a cross-site top-level navigation): Lax, not None.
+                foreach (var c in new[] { o.CorrelationCookie, o.NonceCookie })
+                {
+                    c.SameSite = SameSiteMode.Lax;
+                    c.SecurePolicy = CookieSecurePolicy.Always;
+                    c.HttpOnly = true;
+                }
+                o.Events = new OpenIdConnectEvents
+                {
+                    // The redirect URI is configuration, not "whatever Host header arrived".
+                    OnRedirectToIdentityProvider = ctx => { ctx.ProtocolMessage.RedirectUri = settings.PublicOrigin + BffDefaults.CallbackPath; return Task.CompletedTask; },
+                    // Logout: do not redirect inside an XHR; remember the IdP's end-session URL and let the endpoint hand it to the page.
+                    OnRedirectToIdentityProviderForSignOut = ctx =>
+                    {
+                        ctx.ProtocolMessage.PostLogoutRedirectUri = settings.PublicOrigin + "/";
+                        ctx.Properties.Items["endSessionUrl"] = ctx.ProtocolMessage.CreateLogoutRequestUrl();
+                        ctx.HandleResponse();
+                        return Task.CompletedTask;
+                    },
+                    // No stack traces or protocol details for the user: the log has them, the page gets a generic error.
+                    OnRemoteFailure = ctx =>
+                    {
+                        ctx.HttpContext.RequestServices.GetRequiredService<ILoggerFactory>().CreateLogger("SecLab.Gateway.Bff").LogWarning(ctx.Failure, "Sign-in failed");
+                        ctx.Response.Redirect("/login?error=signin_failed");
+                        ctx.HandleResponse();
+                        return Task.CompletedTask;
+                    },
+                };
+            });
+
+        // The stores and clocks come from DI, so they are configured through options.
+        services.AddOptions<CookieAuthenticationOptions>(BffDefaults.CookieScheme).Configure<SessionStore, TimeProvider>((o, store, clock) => { o.SessionStore = store; o.TimeProvider = clock; });
+        services.AddOptions<OpenIdConnectOptions>(BffDefaults.OidcScheme).Configure<TimeProvider>((o, clock) => o.TimeProvider = clock);
+    }
+
+    /// <summary>For requests to /api that carry the session cookie: CSRF rules, then swap the cookie for the session's access token.</summary>
+    public static IApplicationBuilder UseBffSession(this IApplicationBuilder app) => app.Use(async (ctx, next) =>
+    {
+        var req = ctx.Request;
+        var isApi = req.Path.StartsWithSegments("/api", StringComparison.OrdinalIgnoreCase);
+        if (!isApi || !req.Cookies.ContainsKey(BffDefaults.CookieName)) { await next(); return; }      // bearer / API-key clients and anonymous callers: untouched
+
+        if (!BffCsrf.Allows(req)) { ctx.Response.StatusCode = StatusCodes.Status403Forbidden; return; }
+
+        var (outcome, token, _) = await ctx.RequestServices.GetRequiredService<SessionTokens>().GetAccessTokenAsync(ctx);
+        switch (outcome)
+        {
+            case TokenOutcome.Ok:
+                req.Headers.Authorization = "Bearer " + token;             // whatever the browser sent as Authorization is replaced, never trusted
+                await next();
+                return;
+            case TokenOutcome.Unavailable:
+                ctx.Response.Headers.RetryAfter = "5";
+                ctx.Response.StatusCode = StatusCodes.Status503ServiceUnavailable;
+                return;
+            default:
+                ClearCookie(ctx);
+                ctx.Response.Headers.WWWAuthenticate = "Bearer";
+                ctx.Response.StatusCode = StatusCodes.Status401Unauthorized;
+                return;
+        }
+    });
+
+    public static void MapBff(this IEndpointRouteBuilder app)
+    {
+        app.MapGet("/bff/login", (string? returnUrl) =>
+            Results.Challenge(new AuthenticationProperties { RedirectUri = LocalUrl(returnUrl) }, [BffDefaults.OidcScheme]));
+
+        app.MapGet("/bff/user", async (HttpContext ctx) =>
+        {
+            var (session, _) = await ctx.RequestServices.GetRequiredService<SessionTokens>().Resolve(ctx);
+            if (session is null) { ClearCookie(ctx); return Results.Unauthorized(); }
+            ctx.Response.Headers.CacheControl = "no-store";
+            var user = session.Ticket.Principal;
+            // An allow-list of claims for the page to display. Never the principal as a whole, never a token.
+            return Results.Json(new { username = user.FindFirst("preferred_username")?.Value, name = user.FindFirst("name")?.Value, sub = user.FindFirst("sub")?.Value });
+        });
+
+        app.MapPost("/bff/logout", async (HttpContext ctx) =>
+        {
+            if (!BffCsrf.Allows(ctx.Request)) return Results.StatusCode(StatusCodes.Status403Forbidden);
+            var (session, key) = await ctx.RequestServices.GetRequiredService<SessionTokens>().Resolve(ctx);
+            if (session is null || key is null) { ClearCookie(ctx); return Results.Unauthorized(); }
+
+            var properties = new AuthenticationProperties();
+            await ctx.SignOutAsync(BffDefaults.OidcScheme, properties);    // builds the end-session URL (with id_token_hint) into properties
+            ctx.RequestServices.GetRequiredService<SessionStore>().Remove(key);                    // the session is gone on the server ...
+            await ctx.SignOutAsync(BffDefaults.CookieScheme);               // ... and the cookie is cleared in the browser
+            properties.Items.TryGetValue("endSessionUrl", out var url);
+            ctx.Response.Headers.CacheControl = "no-store";
+            return Results.Json(new { endSessionUrl = url });
+        });
+    }
+
+    static string LocalUrl(string? url) =>
+        !string.IsNullOrEmpty(url) && url[0] == '/' && !url.StartsWith("//") && !url.Contains('\\') && !url.Any(char.IsControl) ? url : "/";
+
+    static void ClearCookie(HttpContext ctx)
+    {
+        if (!ctx.Request.Cookies.ContainsKey(BffDefaults.CookieName)) return;          // nothing to clear: visitors without a session get no Set-Cookie at all
+        ctx.Response.Cookies.Delete(BffDefaults.CookieName, new CookieOptions { Secure = true, HttpOnly = true, SameSite = SameSiteMode.Strict, Path = "/" });
+    }
+}
+
+/// <summary>CSRF rules for requests that are authenticated by an ambient credential (the session cookie).</summary>
+public static class BffCsrf
+{
+    public static bool Allows(HttpRequest req)
+    {
+        if (HttpMethods.IsGet(req.Method) || HttpMethods.IsHead(req.Method) || HttpMethods.IsOptions(req.Method)) return true;     // safe methods do not change anything
+        // A custom header cannot be added by a form or an <img>, and a cross-origin fetch with one needs a CORS preflight that this gateway never grants.
+        if (req.Headers[BffDefaults.CsrfHeader] != "1") return false;
+        // Belt and braces: browsers say where a request came from. Anything but our own origin (or no browser context at all) is refused.
+        var site = req.Headers["Sec-Fetch-Site"].ToString();
+        return site is "" or "same-origin" or "none";
+    }
+}
