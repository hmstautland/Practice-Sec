diff --color -ruN -x bin -x obj -x dist -x node_modules -x certs -x '*.log' -x '*.png' mid13/backend/Directory.Build.props sol13/backend/Directory.Build.props
--- a/backend/Directory.Build.props	1970-01-01 01:00:00.000000000 +0100
+++ b/backend/Directory.Build.props	2026-09-30 12:14:18.918338310 +0200
@@ -0,0 +1,11 @@
+<Project>
+  <!-- Supply chain: know what you ship, fail the build when a dependency has a known vulnerability, restore reproducibly. -->
+  <PropertyGroup>
+    <NuGetAudit>true</NuGetAudit>
+    <NuGetAuditMode>all</NuGetAuditMode>                 <!-- direct AND transitive packages -->
+    <NuGetAuditLevel>low</NuGetAuditLevel>
+    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>   <!-- low, moderate, high, critical advisories -->
+    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
+    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>            <!-- CI refuses to change the resolved versions -->
+  </PropertyGroup>
+</Project>
