--- a/backend/src/SecLab.Api/Errors/GlobalExceptionHandler.cs	1970-01-01 01:00:00.000000000 +0100
+++ b/backend/src/SecLab.Api/Errors/GlobalExceptionHandler.cs	2026-09-30 11:56:07.199478787 +0200
@@ -0,0 +1,36 @@
+using System.Diagnostics;
+using Microsoft.AspNetCore.Diagnostics;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.EntityFrameworkCore;
+
+namespace SecLab.Api.Errors;
+
+/// <summary>
+/// The only place where exceptions turn into responses. Callers get a generic problem-details body and a trace id;
+/// the exception itself (message, stack, inner SQL errors) goes to the log where the trace id lets you find it.
+/// </summary>
+public class GlobalExceptionHandler(IProblemDetailsService problems, ILogger<GlobalExceptionHandler> logger, IConfiguration config) : IExceptionHandler
+{
+    public async ValueTask<bool> TryHandleAsync(HttpContext ctx, Exception exception, CancellationToken ct)
+    {
+        if (exception is OperationCanceledException && ctx.RequestAborted.IsCancellationRequested) return true;   // the client left; nothing to say
+
+        var (status, title) = exception switch
+        {
+            BadHttpRequestException b => (b.StatusCode, "The request could not be read."),
+            DbUpdateConcurrencyException => (StatusCodes.Status409Conflict, "The resource was changed by someone else. Reload and try again."),
+            _ => (StatusCodes.Status500InternalServerError, "An unexpected error occurred."),
+        };
+
+        var traceId = Activity.Current?.Id ?? ctx.TraceIdentifier;
+        if (status >= 500) logger.LogError(exception, "Unhandled exception. TraceId={TraceId} Path={Path}", traceId, ctx.Request.Path.Value);
+        else logger.LogWarning("Request failed with {Status}: {Message}. TraceId={TraceId}", status, exception.Message, traceId);
+
+        ctx.Response.StatusCode = status;
+        var problem = new ProblemDetails { Status = status, Title = title };
+        if (config.GetValue<bool>("Diagnostics:DetailedErrors"))          // explicit opt-in for a developer's own machine
+            problem.Detail = exception.ToString();
+
+        return await problems.TryWriteAsync(new ProblemDetailsContext { HttpContext = ctx, ProblemDetails = problem, Exception = exception });
+    }
+}
