@@ -0,0 +1,182 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.EntityFrameworkCore;
+using Xunit;
+
+namespace SecLab.Api.Tests.Learner;
+
+// Step 16 - integration tests: the real HTTP pipeline, the real EF Core model and the real SQL Server from docker compose
+// (the same engine, the same least-privilege login, the same migrations as production - not an in-memory fake that has
+// no constraints, no permissions and different SQL translation).
+// Rules these tests follow: every test creates its own uniquely named data (no clean-up order, no shared rows); nothing is
+// asserted about rows it did not create; limits that are not under test are lifted; the test asks the DATABASE, not only the API.
+[Trait("Step", "16")]
+[Trait("Kind", "Integration")]
+public class DatabaseIntegrationTests(WebApplicationFactory<Program> factory) : IClassFixture<WebApplicationFactory<Program>>, IDisposable
+{
+    readonly EnvScope _env = new(("RateLimiting__Anonymous", "100000"), ("RateLimiting__User", "100000"), ("RateLimiting__Login", "100000"));
+    readonly List<Harness> _harnesses = [];
+    public void Dispose() { foreach (var h in _harnesses) h.Dispose(); _env.Dispose(); }
+
+    Harness NewHost() { var h = new Harness(factory); _harnesses.Add(h); return h; }
+    static string Unique(string prefix) => prefix + Guid.NewGuid().ToString("N")[..10];
+
+    [Fact]
+    public void The_tests_run_as_the_application_login_on_a_fully_migrated_database()
+    {
+        var h = NewHost();
+        var (login, pending) = h.InDb(db =>
+        {
+            var conn = db.Database.GetDbConnection(); conn.Open();
+            using var cmd = conn.CreateCommand(); cmd.CommandText = "SELECT SUSER_NAME()";
+            var name = (string)cmd.ExecuteScalar()!; conn.Close();
+            return (name, db.Database.GetPendingMigrations().ToList());
+        });
+        Assert.Equal("seclab_app", login);       // not sa: the suite exercises the privileges production has
+        Assert.Empty(pending);
+    }
+
+    [Fact]
+    public async Task A_registered_password_is_stored_as_a_salted_hash_and_never_as_text()
+    {
+        var h = NewHost();
+        var name = Unique("i"); const string password = "correct-horse-battery-staple";
+        var res = await h.Anonymous().PostAsJsonAsync("/api/auth/register", new { username = name, password, displayName = "I", email = $"{name}@example.com" });
+        Assert.Equal(HttpStatusCode.Created, res.StatusCode);
+
+        var row = h.InDb(db => db.Users.AsNoTracking().Single(u => u.Username == name));
+        Assert.True(row.PasswordIsHashed);
+        Assert.NotEqual(password, row.Password);
+        Assert.DoesNotContain(password, row.Password);
+        Assert.False(h.DatabaseContains(password), "the password appears somewhere in the database");
+
+        // two users with the same password get different hashes (salt)
+        var other = Unique("j");
+        await h.Anonymous().PostAsJsonAsync("/api/auth/register", new { username = other, password, displayName = "J", email = $"{other}@example.com" });
+        Assert.NotEqual(row.Password, h.InDb(db => db.Users.AsNoTracking().Single(u => u.Username == other).Password));
+    }
+
+    [Fact]
+    public async Task A_lock_out_survives_a_restart_because_it_lives_in_the_database()
+    {
+        var first = NewHost();
+        var name = Unique("l"); const string password = "correct-horse-battery-staple";
+        await first.Anonymous().PostAsJsonAsync("/api/auth/register", new { username = name, password, displayName = "L", email = $"{name}@example.com" });
+        for (var i = 0; i < 5; i++) Assert.Equal(HttpStatusCode.Unauthorized, (await first.Anonymous().PostAsJsonAsync("/api/auth/login", new { username = name, password = "wrong-" + i })).StatusCode);
+        Assert.True(first.InDb(db => db.Users.Single(u => u.Username == name).LockoutEnd) > DateTime.UtcNow);
+
+        var restarted = NewHost();      // a second host = a "restart": new process memory, same database
+        var res = await restarted.Anonymous().PostAsJsonAsync("/api/auth/login", new { username = name, password });
+        Assert.Equal(HttpStatusCode.Unauthorized, res.StatusCode);                       // the right password is still refused
+
+        restarted.InDb(db => { db.Users.Where(u => u.Username == name).ExecuteUpdate(s => s.SetProperty(u => u.LockoutEnd, (DateTime?)null)); return 0; });   // time passes
+        Assert.Equal(HttpStatusCode.OK, (await restarted.Anonymous().PostAsJsonAsync("/api/auth/login", new { username = name, password })).StatusCode);
+    }
+
+    [Fact]
+    public async Task An_api_key_is_stored_as_a_hash_works_until_revoked_and_the_secret_exists_nowhere_in_the_database()
+    {
+        var h = NewHost();
+        var owner = h.NewPerson();
+        var created = JsonDocument.Parse(await (await owner.Http.PostAsJsonAsync("/api/keys", new { name = "it", level = "write" })).Content.ReadAsStringAsync()).RootElement;
+        var (id, key) = (created.GetProperty("id").GetInt32(), created.GetProperty("apiKey").GetString()!);
+        var secret = key.Split('_')[2];
+
+        var row = h.InDb(db => db.ApiKeys.AsNoTracking().Single(k => k.Id == id));
+        Assert.Equal(32, row.KeyHash.Length);
+        Assert.Equal(owner.Id, row.OwnerId);
+        Assert.False(h.DatabaseContains(secret));
+
+        HttpRequestMessage Call() { var r = new HttpRequestMessage(HttpMethod.Get, "/api/partner/blogs"); r.Headers.Add("X-Api-Key", key); return r; }
+        Assert.Equal(HttpStatusCode.OK, (await h.Anonymous().SendAsync(Call())).StatusCode);
+        Assert.NotNull(h.InDb(db => db.ApiKeys.Single(k => k.Id == id).LastUsedAt));          // use is recorded
+
+        Assert.Equal(HttpStatusCode.NoContent, (await owner.Http.DeleteAsync($"/api/keys/{id}")).StatusCode);
+        Assert.NotNull(h.InDb(db => db.ApiKeys.Single(k => k.Id == id).RevokedAt));
+        Assert.Equal(HttpStatusCode.Unauthorized, (await h.Anonymous().SendAsync(Call())).StatusCode);   // and a different host sees the revocation immediately
+    }
+
+    [Fact]
+    public async Task Personal_data_is_encrypted_in_the_table_but_readable_through_the_api()
+    {
+        var h = NewHost();
+        var p = h.NewPerson();
+        var phone = "+47 " + Random.Shared.Next(100_000_000, 999_999_999);
+        Assert.Equal(HttpStatusCode.OK, (await p.Http.PutAsJsonAsync($"/api/users/{p.Id}", new { phone, address = "Hemmelig gate 7" })).StatusCode);
+
+        var me = JsonDocument.Parse(await (await p.Http.GetAsync("/api/me")).Content.ReadAsStringAsync()).RootElement;
+        Assert.Equal(phone, me.GetProperty("phone").GetString());
+        Assert.False(h.DatabaseContains(phone));
+        Assert.False(h.DatabaseContains("Hemmelig gate 7"));
+    }
+
+    [Fact]
+    public async Task Deleting_a_blog_leaves_no_orphaned_likes()
+    {
+        var h = NewHost();
+        var (author, a, b) = (h.NewPerson(), h.NewPerson(), h.NewPerson());
+        var id = await NewBlog(author);
+        Assert.Equal(HttpStatusCode.NoContent, (await a.Http.PostAsync($"/api/blogs/{id}/like", null)).StatusCode);
+        Assert.Equal(HttpStatusCode.NoContent, (await b.Http.PostAsync($"/api/blogs/{id}/like", null)).StatusCode);
+        Assert.Equal(2, h.InDb(db => db.BlogLikes.Count(l => l.BlogId == id)));
+
+        Assert.Equal(HttpStatusCode.NoContent, (await author.Http.DeleteAsync($"/api/blogs/{id}")).StatusCode);
+        Assert.Equal(0, h.InDb(db => db.BlogLikes.Count(l => l.BlogId == id)));
+        Assert.Equal(0, h.InDb(db => db.Blogs.Count(x => x.Id == id)));
+    }
+
+    // ---------------- concurrency: what a sequential test can never see ----------------
+    // "Check, then insert" is two statements. Two requests can both pass the check. Only the database can make the second one fail.
+
+    [Fact]
+    public async Task Concurrent_duplicate_likes_are_idempotent_and_never_a_server_error()
+    {
+        var h = NewHost();
+        var (author, fan) = (h.NewPerson(), h.NewPerson());
+        for (var round = 0; round < 5; round++)        // a race is a matter of timing: several rounds make "never" mean never
+        {
+            var id = await NewBlog(author);
+            var answers = await Task.WhenAll(Enumerable.Range(0, 8).Select(_ => fan.Http.PostAsync($"/api/blogs/{id}/like", null)));
+
+            Assert.All(answers, r => Assert.Equal(HttpStatusCode.NoContent, r.StatusCode));
+            Assert.Equal(1, h.InDb(db => db.BlogLikes.Count(l => l.BlogId == id && l.UserId == fan.Id)));
+        }
+    }
+
+    [Fact]
+    public async Task Concurrent_registrations_of_the_same_username_create_exactly_one_account()
+    {
+        var h = NewHost();
+        var name = Unique("c");
+        var answers = await Task.WhenAll(Enumerable.Range(0, 6).Select(_ => h.Anonymous().PostAsJsonAsync("/api/auth/register",
+            new { username = name, password = "correct-horse-battery-staple", displayName = "C", email = $"{name}@example.com" })));
+
+        Assert.Equal(1, answers.Count(r => r.StatusCode == HttpStatusCode.Created));
+        Assert.All(answers.Where(r => r.StatusCode != HttpStatusCode.Created), r => Assert.Equal(HttpStatusCode.Conflict, r.StatusCode));   // a clean 409, not a 500
+        Assert.Equal(1, h.InDb(db => db.Users.Count(u => u.Username == name)));                                                              // the database is the judge
+    }
+
+    [Fact]
+    public void The_database_itself_rejects_a_duplicate_where_the_model_says_unique()
+    {
+        var h = NewHost();
+        var p = h.NewPerson();
+        var prefix = Unique("P")[..8];
+        var ex = Assert.ThrowsAny<DbUpdateException>(() => h.InDb(db =>
+        {
+            db.ApiKeys.Add(new SecLab.Api.Models.ApiKey { OwnerId = p.Id, Name = "a", Prefix = prefix, KeyHash = new byte[32], Level = "read" });
+            db.ApiKeys.Add(new SecLab.Api.Models.ApiKey { OwnerId = p.Id, Name = "b", Prefix = prefix, KeyHash = new byte[32], Level = "read" });
+            return db.SaveChanges();
+        }));
+        Assert.Contains("IX_ApiKeys_Prefix", ex.InnerException?.Message ?? ex.Message);
+    }
+
+    static async Task<int> NewBlog(Harness.Person who)
+    {
+        var res = await who.Http.PostAsJsonAsync("/api/blogs", new { title = Unique("b"), body = "<p>x</p>" });
+        Assert.Equal(HttpStatusCode.Created, res.StatusCode);
+        return JsonDocument.Parse(await res.Content.ReadAsStringAsync()).RootElement.GetProperty("id").GetInt32();
+    }
+}
