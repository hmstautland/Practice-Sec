--- a/backend/src/SecLab.Api/Security/SecurityHeaders.cs	1970-01-01 01:00:00.000000000 +0100
+++ b/backend/src/SecLab.Api/Security/SecurityHeaders.cs	2026-09-30 12:13:03.759431292 +0200
@@ -0,0 +1,31 @@
+namespace SecLab.Api.Security;
+
+/// <summary>
+/// Defensive response headers for an API that only ever returns JSON (or, for avatars, images).
+/// Set with "add if absent" semantics so a more specific component (e.g. the static-file options) can be stricter.
+/// </summary>
+public static class SecurityHeaders
+{
+    static readonly (string Name, string Value)[] Always =
+    [
+        ("X-Content-Type-Options", "nosniff"),                                        // never let a browser guess a type
+        ("Content-Security-Policy", "default-src 'none'; frame-ancestors 'none'"),    // an API response should never run or embed anything
+        ("X-Frame-Options", "DENY"),                                                  // legacy browsers
+        ("Referrer-Policy", "no-referrer"),
+        ("Permissions-Policy", "camera=(), microphone=(), geolocation=(), payment=(), usb=()"),
+        ("Cross-Origin-Resource-Policy", "same-site"),                                // the SPA (same site, other port) may load images; other sites may not
+    ];
+
+    public static IApplicationBuilder UseSecurityHeaders(this IApplicationBuilder app) =>
+        app.Use((ctx, next) =>
+        {
+            ctx.Response.OnStarting(() =>
+            {
+                var h = ctx.Response.Headers;
+                foreach (var (name, value) in Always) if (!h.ContainsKey(name)) h[name] = value;
+                if (ctx.Request.Path.StartsWithSegments("/api")) h.CacheControl = "no-store";   // personal data must not sit in shared caches
+                return Task.CompletedTask;
+            });
+            return next();
+        });
+}
