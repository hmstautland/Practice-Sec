+    // ---------- admin network ----------
+    static async Task<bool> AdminNetworkAllows(string? ip, params string[] networks)
+    {
+        var config = new ConfigurationBuilder().AddInMemoryCollection(networks.Select((n, i) => KeyValuePair.Create($"Admin:AllowedNetworks:{i}", (string?)n))).Build();
+        var requirement = new AdminNetworkRequirement();
+        var http = new DefaultHttpContext();
+        if (ip is not null) http.Connection.RemoteIpAddress = IPAddress.Parse(ip);
+        var ctx = new AuthorizationHandlerContext([requirement], new ClaimsPrincipal(), http);
+        await new AdminNetworkHandler(config).HandleAsync(ctx);
+        return ctx.HasSucceeded;
+    }
