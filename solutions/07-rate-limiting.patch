diff --color -ruN -x bin -x obj -x dist -x node_modules -x certs -x '*.log' mid07/backend/src/SecLab.Api/RateLimiting/RateLimiting.cs sol07/backend/src/SecLab.Api/RateLimiting/RateLimiting.cs
--- a/backend/src/SecLab.Api/RateLimiting/RateLimiting.cs	1970-01-01 01:00:00.000000000 +0100
+++ b/backend/src/SecLab.Api/RateLimiting/RateLimiting.cs	2026-09-30 11:27:28.077878339 +0200
@@ -0,0 +1,102 @@
+using System.Net;
+using System.Security.Claims;
+using System.Threading.RateLimiting;
+using Microsoft.AspNetCore.Authentication;
+using Microsoft.AspNetCore.HttpOverrides;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.AspNetCore.RateLimiting;
+using SecLab.Api.Authorization;
+
+namespace SecLab.Api.RateLimiting;
+
+/// <summary>Requests per window. Bound from the "RateLimiting" configuration section (env: RateLimiting__Anonymous=5).</summary>
+public class RateLimitSettings
+{
+    public int WindowSeconds { get; set; } = 60;
+    public int Anonymous { get; set; } = 20;      // per client IP
+    public int User { get; set; } = 120;          // per signed-in user
+    public int Login { get; set; } = 5;           // per client IP, login + registration
+    public int ApiKeyRead { get; set; } = 60;     // per key
+    public int ApiKeyWrite { get; set; } = 300;
+    public int ApiKeyAdmin { get; set; } = 1000;
+}
+
+public static class RateLimiting
+{
+    public const string LoginPolicy = "login";
+    const string ApiKeyItem = "seclab.apikey.principal";
+
+    static FixedWindowRateLimiterOptions Window(int permits, RateLimitSettings s) => new()
+    {
+        PermitLimit = permits, Window = TimeSpan.FromSeconds(s.WindowSeconds), QueueLimit = 0, AutoReplenishment = true,
+    };
+
+    static string ClientIp(HttpContext ctx) => ctx.Connection.RemoteIpAddress?.ToString() ?? "unknown";   // after UseForwardedHeaders: the *trusted* view of the client
+
+    public static IServiceCollection AddSecLabRateLimiting(this IServiceCollection services, IConfiguration config)
+    {
+        var s = config.GetSection("RateLimiting").Get<RateLimitSettings>() ?? new();
+
+        services.AddRateLimiter(o =>
+        {
+            o.RejectionStatusCode = StatusCodes.Status429TooManyRequests;
+
+            // Every request is counted in exactly one bucket, chosen by *who* is calling.
+            o.GlobalLimiter = PartitionedRateLimiter.Create<HttpContext, string>(ctx =>
+            {
+                if (ctx.Items[ApiKeyItem] is ClaimsPrincipal key)
+                {
+                    var limit = key.FindFirst(ApiKeyDefaults.LevelClaim)?.Value switch { "admin" => s.ApiKeyAdmin, "write" => s.ApiKeyWrite, _ => s.ApiKeyRead };
+                    return RateLimitPartition.GetFixedWindowLimiter("key:" + key.FindFirst("api_key_id")?.Value, _ => Window(limit, s));
+                }
+                if (ctx.User.Identity?.IsAuthenticated == true)
+                    return RateLimitPartition.GetFixedWindowLimiter("user:" + (ctx.User.FindFirst(LocalUserClaims.LocalUserId)?.Value ?? ctx.User.FindFirst("sub")?.Value),
+                        _ => Window(s.User, s));
+                return RateLimitPartition.GetFixedWindowLimiter("ip:" + ClientIp(ctx), _ => Window(s.Anonymous, s));   // also bad/unknown API keys
+            });
+
+            // Extra, much stricter bucket for credential endpoints: counts per IP whatever username is tried.
+            o.AddPolicy(LoginPolicy, ctx => RateLimitPartition.GetFixedWindowLimiter("login:" + ClientIp(ctx), _ => Window(s.Login, s)));
+
+            o.OnRejected = async (context, ct) =>
+            {
+                var http = context.HttpContext;
+                var retryAfter = context.Lease.TryGetMetadata(MetadataName.RetryAfter, out var ra) ? (int)Math.Ceiling(ra.TotalSeconds) : s.WindowSeconds;
+                http.Response.StatusCode = StatusCodes.Status429TooManyRequests;
+                http.Response.Headers.RetryAfter = Math.Max(1, retryAfter).ToString();
+                await http.Response.WriteAsJsonAsync(new ProblemDetails
+                {
+                    Status = 429, Title = "Too many requests", Detail = $"Try again in {Math.Max(1, retryAfter)} seconds.",
+                }, options: null, contentType: "application/problem+json", cancellationToken: ct);
+            };
+        });
+
+        // Trust X-Forwarded-* ONLY from proxies we list.
+        // CAREFUL: with both KnownProxies and KnownNetworks empty the middleware trusts EVERY sender, so it is only enabled
+        // (see UseSecLabForwardedHeaders) when at least one proxy is configured. No proxy configured = headers ignored.
+        services.Configure<ForwardedHeadersOptions>(o =>
+        {
+            o.ForwardedHeaders = ForwardedHeaders.XForwardedFor | ForwardedHeaders.XForwardedProto;
+            o.ForwardLimit = 1;
+            o.KnownNetworks.Clear(); o.KnownProxies.Clear();
+            foreach (var ip in config.GetSection("Proxy:KnownProxies").Get<string[]>() ?? []) o.KnownProxies.Add(IPAddress.Parse(ip));
+        });
+        return services;
+    }
+
+    public static IApplicationBuilder UseSecLabForwardedHeaders(this IApplicationBuilder app, IConfiguration config) =>
+        (config.GetSection("Proxy:KnownProxies").Get<string[]>() ?? []).Length > 0 ? app.UseForwardedHeaders() : app;
+
+    /// <summary>API-key authentication is normally triggered by the authorization policy, which is too late for the limiter:
+    /// authenticate the key early (the result is cached for the request) so the limiter can pick the key's bucket and level.</summary>
+    public static IApplicationBuilder UseApiKeyPreAuthentication(this IApplicationBuilder app) =>
+        app.Use(async (ctx, next) =>
+        {
+            if (ctx.Request.Headers.ContainsKey(ApiKeyDefaults.Header))
+            {
+                var result = await ctx.AuthenticateAsync(ApiKeyDefaults.Scheme);
+                if (result.Succeeded) ctx.Items[ApiKeyItem] = result.Principal;
+            }
+            await next();
+        });
+}
