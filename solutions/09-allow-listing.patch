--- a/backend/src/SecLab.Api/Security/OutboundUrlPolicy.cs	1970-01-01 01:00:00.000000000 +0100
+++ b/backend/src/SecLab.Api/Security/OutboundUrlPolicy.cs	2026-09-30 11:45:16.372848742 +0200
@@ -0,0 +1,45 @@
+using System.Net;
+using System.Net.Sockets;
+
+namespace SecLab.Api.Security;
+
+/// <summary>Server-side requests only go where we say. Validate the URL string here, and the resolved address at connect time.</summary>
+public static class OutboundUrlPolicy
+{
+    public static bool TryValidate(string? raw, IReadOnlyCollection<string> allowedHosts, out Uri? uri)
+    {
+        uri = null;
+        if (string.IsNullOrWhiteSpace(raw) || raw.Length > 2048) return false;
+        if (!Uri.TryCreate(raw, UriKind.Absolute, out var u)) return false;
+        if (u.Scheme != Uri.UriSchemeHttps) return false;                          // no http, file, gopher, ...
+        if (!string.IsNullOrEmpty(u.UserInfo)) return false;                       // https://good.example@evil.example/
+        if (!u.IsDefaultPort) return false;                                        // only 443
+        if (u.HostNameType != UriHostNameType.Dns) return false;                   // no IP literals of any kind
+        if (!allowedHosts.Contains(u.IdnHost, StringComparer.OrdinalIgnoreCase)) return false;   // exact host, never "ends with" / "contains"
+        uri = u;
+        return true;
+    }
+
+    /// <summary>Second line of defence against DNS tricks: refuse to connect to non-public addresses.</summary>
+    public static bool IsPublic(IPAddress ip)
+    {
+        if (ip.IsIPv4MappedToIPv6) ip = ip.MapToIPv4();
+        if (IPAddress.IsLoopback(ip) || ip.Equals(IPAddress.Any) || ip.Equals(IPAddress.IPv6Any) || ip.Equals(IPAddress.None)) return false;
+        if (ip.AddressFamily == AddressFamily.InterNetworkV6)
+            return !(ip.IsIPv6LinkLocal || ip.IsIPv6SiteLocal || ip.IsIPv6Multicast || ip.IsIPv6UniqueLocal);
+        var b = ip.GetAddressBytes();
+        return !(b[0] == 10 || b[0] == 127 || b[0] == 0 || b[0] >= 224 ||
+                 (b[0] == 172 && b[1] is >= 16 and <= 31) || (b[0] == 192 && b[1] == 168) ||
+                 (b[0] == 169 && b[1] == 254) || (b[0] == 100 && b[1] is >= 64 and <= 127));
+    }
+
+    public static async ValueTask<Stream> SafeConnect(SocketsHttpConnectionContext ctx, CancellationToken ct)
+    {
+        var addresses = await Dns.GetHostAddressesAsync(ctx.DnsEndPoint.Host, ct);
+        var target = addresses.FirstOrDefault(IsPublic) ?? throw new HttpRequestException("Destination address is not public.");
+        if (addresses.Any(a => !IsPublic(a))) throw new HttpRequestException("Host resolves to a non-public address.");   // mixed answers: refuse (rebinding)
+        var socket = new Socket(target.AddressFamily, SocketType.Stream, ProtocolType.Tcp) { NoDelay = true };
+        try { await socket.ConnectAsync(new IPEndPoint(target, ctx.DnsEndPoint.Port), ct); return new NetworkStream(socket, ownsSocket: true); }
+        catch { socket.Dispose(); throw; }
+    }
+}
