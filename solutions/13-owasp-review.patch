 import react from '@vitejs/plugin-react'
 
 // Certificate exported with: dotnet dev-certs https --export-path ../certs/dev.pem --format Pem --no-password
+const https = fs.existsSync('../certs/dev.pem')
+  ? { cert: fs.readFileSync('../certs/dev.pem'), key: fs.readFileSync('../certs/dev.key') }
+  : undefined
+
+// The production build is static files; whoever serves them (`vite preview` here, a CDN or the gateway later) must send these headers.
+// The dev server cannot use this CSP: hot reload injects inline scripts.
+const API = 'https://localhost:5443'
+const IDP = 'http://localhost:8081'
+const securityHeaders = {
+  'Content-Security-Policy': [
+    "default-src 'self'",
+    "script-src 'self'",
+    "style-src 'self'",
+    `connect-src 'self' ${API} ${IDP}`,
+    `img-src 'self' ${API} https://i.pravatar.cc data:`,
+    "object-src 'none'",
+    "base-uri 'none'",
+    "form-action 'self'",
+    "frame-ancestors 'none'",
+  ].join('; '),
+  'X-Content-Type-Options': 'nosniff',
+  'Referrer-Policy': 'no-referrer',
+  'Permissions-Policy': 'camera=(), microphone=(), geolocation=()',
+}
