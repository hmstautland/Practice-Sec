diff --color -ruN -x bin -x obj -x dist -x node_modules -x certs -x '*.log' -x '*.png' mid14/backend/src/SecLab.Gateway/Program.cs sol14/backend/src/SecLab.Gateway/Program.cs
--- a/backend/src/SecLab.Gateway/Program.cs	1970-01-01 01:00:00.000000000 +0100
+++ b/backend/src/SecLab.Gateway/Program.cs	2026-09-30 12:34:10.806294072 +0200
@@ -0,0 +1,114 @@
+using System.Net;
+using System.Security.Authentication;
+using System.Threading.RateLimiting;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.AspNetCore.RateLimiting;
+using Yarp.ReverseProxy.Transforms;
+
+var builder = WebApplication.CreateBuilder(args);
+var gw = builder.Configuration.GetSection("Gateway");
+var permitsPerMinute = gw.GetValue("RateLimitPerMinute", 300);
+var maxBody = gw.GetValue("MaxBodyBytes", 3L * 1024 * 1024);
+var adminNetworks = (gw.GetSection("AdminNetworks").Get<string[]>() ?? []).Select(IPNetwork.Parse).ToArray();
+
+// ---- the edge is the only thing listening on the public port ----
+builder.WebHost.ConfigureKestrel(k =>
+{
+    k.AddServerHeader = false;
+    k.Limits.MaxRequestBodySize = maxBody;                       // chunked bodies too (the middleware below handles Content-Length early)
+    k.Limits.MaxRequestHeadersTotalSize = 32 * 1024;
+    k.Limits.RequestHeadersTimeout = TimeSpan.FromSeconds(15);   // slow-header attacks
+    k.ConfigureHttpsDefaults(h => h.SslProtocols = SslProtocols.Tls12 | SslProtocols.Tls13);
+});
+builder.Services.AddHsts(o => { o.MaxAge = TimeSpan.FromDays(365); o.IncludeSubDomains = true; });
+builder.Services.AddProblemDetails();
+builder.Services.AddRequestTimeouts();                            // routes name their Timeout in configuration
+
+builder.Services.AddRateLimiter(o =>
+{
+    o.RejectionStatusCode = StatusCodes.Status429TooManyRequests;
+    // Coarse, cheap, per client address. The API keeps its finer per-user / per-key limits (step 07).
+    o.GlobalLimiter = PartitionedRateLimiter.Create<HttpContext, string>(ctx => RateLimitPartition.GetFixedWindowLimiter(
+        ctx.Connection.RemoteIpAddress?.ToString() ?? "unknown",
+        _ => new FixedWindowRateLimiterOptions { PermitLimit = permitsPerMinute, Window = TimeSpan.FromMinutes(1), QueueLimit = 0 }));
+    o.OnRejected = (context, _) =>
+    {
+        var seconds = context.Lease.TryGetMetadata(MetadataName.RetryAfter, out var ra) ? (int)Math.Ceiling(ra.TotalSeconds) : 60;
+        context.HttpContext.Response.Headers.RetryAfter = Math.Max(1, seconds).ToString();
+        return ValueTask.CompletedTask;
+    };
+});
+
+builder.Services.AddReverseProxy()
+    .LoadFromConfig(builder.Configuration.GetSection("ReverseProxy"))
+    .AddTransforms(ctx => ctx.AddRequestTransform(t =>
+    {
+        // Anything a client sends that looks like "our" internal signalling never reaches the API.
+        foreach (var name in t.HttpContext.Request.Headers.Keys.Where(k => k.StartsWith("X-Gateway-", StringComparison.OrdinalIgnoreCase) || k.StartsWith("X-Internal-", StringComparison.OrdinalIgnoreCase)).ToList())
+            t.ProxyRequest.Headers.Remove(name);
+        return ValueTask.CompletedTask;
+    }));
+
+var app = builder.Build();
+
+if (!app.Environment.IsDevelopment()) app.UseHsts();
+app.UseHttpsRedirection();
+app.UseExceptionHandler(errors => errors.Run(async ctx =>                       // never show internals
+{
+    ctx.Response.StatusCode = StatusCodes.Status500InternalServerError;
+    await ctx.Response.WriteAsJsonAsync(new ProblemDetails { Status = 500, Title = "An unexpected error occurred." }, options: null, contentType: "application/problem+json");
+}));
+app.UseStatusCodePages();                                                        // bare 401/404/405/413/429/502 -> problem+json
+
+// Defensive headers on everything the gateway itself answers; responses from the API keep their own (add-if-absent).
+app.Use((ctx, next) =>
+{
+    ctx.Response.OnStarting(() =>
+    {
+        var h = ctx.Response.Headers;
+        foreach (var (n, v) in new[] { ("X-Content-Type-Options", "nosniff"), ("Referrer-Policy", "no-referrer"), ("X-Frame-Options", "DENY"),
+                                        ("Content-Security-Policy", "default-src 'none'; frame-ancestors 'none'") })
+            if (!h.ContainsKey(n)) h[n] = v;
+        return Task.CompletedTask;
+    });
+    return next();
+});
+
+app.UseRateLimiter();            // counts everything, including what is refused below
+app.UseRequestTimeouts();
+
+// ---- edge policy: refuse cheap-to-refuse things before they cost the API anything ----
+app.Use(async (ctx, next) =>
+{
+    var req = ctx.Request;
+    var path = req.Path.Value ?? "";
+
+    if (path.Contains('\\') || path.Contains("..") || path.Contains("//")) { ctx.Response.StatusCode = StatusCodes.Status400BadRequest; return; }
+    if (req.ContentLength > maxBody) { ctx.Response.StatusCode = StatusCodes.Status413PayloadTooLarge; return; }
+
+    // Admin and debug functions do not exist for the internet.
+    var isPrivileged = req.Path.StartsWithSegments("/api/admin", StringComparison.OrdinalIgnoreCase) || req.Path.StartsWithSegments("/api/debug", StringComparison.OrdinalIgnoreCase);
+    if (isPrivileged)
+    {
+        var ip = ctx.Connection.RemoteIpAddress;
+        if (ip is { IsIPv4MappedToIPv6: true }) ip = ip.MapToIPv4();
+        if (ip is null || !adminNetworks.Any(n => n.Contains(ip))) { ctx.Response.StatusCode = StatusCodes.Status404NotFound; return; }
+    }
+
+    // Coarse authentication: a request to a protected API area must carry *some* credential of a supported type.
+    // The API still validates it properly (signature, issuer, audience, lifetime, scopes, ownership ...).
+    var isPublic = req.Path.StartsWithSegments("/api/auth", StringComparison.OrdinalIgnoreCase) || HttpMethods.IsOptions(req.Method);
+    if (!isPublic && req.Path.StartsWithSegments("/api", StringComparison.OrdinalIgnoreCase))
+    {
+        var authorization = req.Headers.Authorization.ToString();
+        var hasBearer = authorization.StartsWith("Bearer ", StringComparison.OrdinalIgnoreCase) && authorization.Length > 10;
+        var hasKey = !string.IsNullOrWhiteSpace(req.Headers["X-Api-Key"].ToString());
+        if (!hasBearer && !hasKey) { ctx.Response.Headers.WWWAuthenticate = "Bearer"; ctx.Response.StatusCode = StatusCodes.Status401Unauthorized; return; }
+    }
+    await next();
+});
+
+app.MapReverseProxy();
+app.Run();
+
+public partial class Program;
