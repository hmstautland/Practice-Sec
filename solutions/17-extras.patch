+namespace SecLab.Gateway.Bff;
+
+public static class BffDefaults
+{
+    public const string CookieScheme = "bff-cookie";
+    public const string OidcScheme = "bff-oidc";
+    /// <summary>The "__Host-" prefix makes the browser insist on: Secure, Path=/, no Domain attribute (a sibling subdomain cannot overwrite it).</summary>
+    public const string CookieName = "__Host-seclab-session";
+    public const string CallbackPath = "/bff/callback";
+    public const string CsrfHeader = "X-CSRF";
+}
+
+/// <summary>Everything the BFF reads from the "Bff" configuration section. The client secret comes from the environment (Bff__ClientSecret), never from a file in the repository.</summary>
+public sealed record BffSettings(
+    string Authority,
+    string ClientId,
+    string? ClientSecret,
+    string PublicOrigin,
+    TimeSpan IdleTimeout,
+    TimeSpan SessionLifetime,
+    TimeSpan RefreshSkew)
+{
+    public static BffSettings From(IConfiguration configuration)
+    {
+        var s = configuration.GetSection("Bff");
+        return new BffSettings(
+            Authority: s["Authority"] ?? "",
+            ClientId: s["ClientId"] ?? "seclab-bff",
+            ClientSecret: s["ClientSecret"],
+            PublicOrigin: (s["PublicOrigin"] ?? "https://localhost:5173").TrimEnd('/'),
+            IdleTimeout: s.GetValue("IdleTimeout", TimeSpan.FromMinutes(30)),
+            SessionLifetime: s.GetValue("SessionLifetime", TimeSpan.FromHours(8)),
+            RefreshSkew: s.GetValue("RefreshSkew", TimeSpan.FromMinutes(1)));
+    }
+}
diff --color --color -ruN -x bin -x obj -x dist -x node_modules -x certs -x '*.log' -x '*.png' -x .env mid17/backend/src/SecLab.Gateway/Bff/SessionStore.cs sol17/backend/src/SecLab.Gateway/Bff/SessionStore.cs
--- a/backend/src/SecLab.Gateway/Bff/SessionStore.cs	1970-01-01 01:00:00.000000000 +0100
+++ b/backend/src/SecLab.Gateway/Bff/SessionStore.cs	2026-10-04 22:19:02.345561050 +0200
@@ -0,0 +1,83 @@
+using System.Collections.Concurrent;
+using System.Security.Cryptography;
+using Microsoft.AspNetCore.Authentication;
+using Microsoft.AspNetCore.Authentication.Cookies;
+
+namespace SecLab.Gateway.Bff;
+
+/// <summary>The tokens of one session. Immutable: a refresh swaps the whole object, so readers never see a half-updated pair.</summary>
+public sealed record TokenSet(string AccessToken, string? RefreshToken, DateTimeOffset ExpiresAt);
+
+public sealed class BffSession(AuthenticationTicket ticket, TokenSet tokens, DateTimeOffset now)
+{
+    long _lastSeenTicks = now.UtcTicks;
+    volatile TokenSet _tokens = tokens;
+
+    public AuthenticationTicket Ticket { get; } = ticket;                  // who the user is (claims); the id_token stays here as the logout hint
+    public TokenSet Tokens { get => _tokens; set => _tokens = value; }     // written only while holding RefreshLock
+    public DateTimeOffset CreatedAt { get; } = now;
+    public DateTimeOffset LastSeen { get => new(Interlocked.Read(ref _lastSeenTicks), TimeSpan.Zero); set => Interlocked.Exchange(ref _lastSeenTicks, value.UtcTicks); }
+    /// <summary>One refresh at a time per session: with refresh-token rotation a second, parallel use of the same refresh token looks like theft to the IdP.</summary>
+    public SemaphoreSlim RefreshLock { get; } = new(1, 1);
+    public volatile bool Removed;
+}
+
+/// <summary>
+/// Server-side sessions for the cookie handler (<see cref="ITicketStore"/>): the cookie carries a random key, everything else – claims and
+/// tokens – stays here. In memory, because the lab has one gateway process; with several instances this belongs in a shared store (Redis, SQL).
+/// Idle timeout and absolute lifetime are enforced here, on every lookup, with the registered <see cref="TimeProvider"/>.
+/// </summary>
+public sealed class SessionStore(TimeProvider clock, BffSettings settings) : ITicketStore
+{
+    public const string KeyItem = ".bff.session";
+    readonly ConcurrentDictionary<string, BffSession> _sessions = new();
+
+    public Task<string> StoreAsync(AuthenticationTicket ticket)
+    {
+        Sweep();
+        var props = ticket.Properties;
+        var access = props.GetTokenValue("access_token") ?? throw new InvalidOperationException("the IdP returned no access token");
+        var expiresAt = DateTimeOffset.TryParse(props.GetTokenValue("expires_at"), System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.RoundtripKind, out var e)
+            ? e : clock.GetUtcNow().AddMinutes(1);
+        var tokens = new TokenSet(access, props.GetTokenValue("refresh_token"), expiresAt);
+        // keep only the id_token with the ticket (the end-session request needs it); access and refresh token live in TokenSet
+        var idToken = props.GetTokenValue("id_token");
+        props.StoreTokens(idToken is null ? [] : [new AuthenticationToken { Name = "id_token", Value = idToken }]);
+
+        var key = Convert.ToBase64String(RandomNumberGenerator.GetBytes(32)).TrimEnd('=').Replace('+', '-').Replace('/', '_');   // 256 random bits: a new identifier at every login
+        props.Items[KeyItem] = key;
+        _sessions[key] = new BffSession(ticket, tokens, clock.GetUtcNow());
+        return Task.FromResult(key);
+    }
+
+    public Task RenewAsync(string key, AuthenticationTicket ticket) => Task.CompletedTask;          // sliding cookies are off: the store, not the cookie, tracks activity
+
+    public Task<AuthenticationTicket?> RetrieveAsync(string key) => Task.FromResult(Touch(key)?.Ticket);
+
+    public Task RemoveAsync(string key) { Remove(key); return Task.CompletedTask; }
+
+    /// <summary>The session behind a key, or null when it never existed, was removed, idled out or reached its absolute lifetime. A hit counts as activity.</summary>
+    public BffSession? Touch(string key)
+    {
+        if (!_sessions.TryGetValue(key, out var s)) return null;
+        var now = clock.GetUtcNow();
+        if (Expired(s, now)) { Remove(key); return null; }
+        s.LastSeen = now;
+        return s;
+    }
+
+    public void Remove(string key)
+    {
+        if (_sessions.TryRemove(key, out var s)) s.Removed = true;
+    }
+
+    bool Expired(BffSession s, DateTimeOffset now) => now - s.CreatedAt >= settings.SessionLifetime || now - s.LastSeen >= settings.IdleTimeout;
+
+    void Sweep()
+    {
+        var now = clock.GetUtcNow();
+        foreach (var (key, s) in _sessions) if (Expired(s, now)) Remove(key);
+    }
+
+    public int Count => _sessions.Count;
+}
diff --color --color -ruN -x bin -x obj -x dist -x node_modules -x certs -x '*.log' -x '*.png' -x .env mid17/backend/src/SecLab.Gateway/Bff/SessionTokens.cs sol17/backend/src/SecLab.Gateway/Bff/SessionTokens.cs
--- a/backend/src/SecLab.Gateway/Bff/SessionTokens.cs	1970-01-01 01:00:00.000000000 +0100
+++ b/backend/src/SecLab.Gateway/Bff/SessionTokens.cs	2026-10-04 22:18:23.357349167 +0200
@@ -0,0 +1,98 @@
+using System.Globalization;
+using System.Text.Json;
+using Microsoft.AspNetCore.Authentication;
+using Microsoft.AspNetCore.Authentication.OpenIdConnect;
+using Microsoft.Extensions.Options;
+
+namespace SecLab.Gateway.Bff;
+
+public enum TokenOutcome { Ok, NoSession, Unavailable }
+
+/// <summary>Hands out the access token of the caller's session and renews it – on the server, with the refresh token the browser never sees.</summary>
+public sealed class SessionTokens(SessionStore store, IOptionsMonitor<OpenIdConnectOptions> oidc, BffSettings settings, TimeProvider clock, ILogger<SessionTokens> log)
+{
+    public async Task<(TokenOutcome Outcome, string? AccessToken, string? Key)> GetAccessTokenAsync(HttpContext ctx)
+    {
+        var (session, key) = await Resolve(ctx);
+        if (session is null || key is null) return (TokenOutcome.NoSession, null, null);
+
+        var tokens = session.Tokens;
+        if (!NeedsRefresh(tokens)) return (TokenOutcome.Ok, tokens.AccessToken, key);
+
+        await session.RefreshLock.WaitAsync(ctx.RequestAborted);
+        try
+        {
+            if (session.Removed) return (TokenOutcome.NoSession, null, key);
+            tokens = session.Tokens;                                       // somebody may have refreshed while we waited for the lock
+            if (!NeedsRefresh(tokens)) return (TokenOutcome.Ok, tokens.AccessToken, key);
+            if (tokens.RefreshToken is null) { store.Remove(key); return (TokenOutcome.NoSession, null, key); }
+
+            var (result, fresh) = await Refresh(tokens, ctx.RequestAborted);
+            switch (result)
+            {
+                case RefreshResult.Refused:                                // invalid_grant & co: the IdP session is over, or this refresh token was already used
+                    store.Remove(key);
+                    return (TokenOutcome.NoSession, null, key);
+                case RefreshResult.Unreachable:
+                    // the old token may still be good for a little while: do not turn an IdP hiccup into a logout
+                    return tokens.ExpiresAt > clock.GetUtcNow() ? (TokenOutcome.Ok, tokens.AccessToken, key) : (TokenOutcome.Unavailable, null, key);
+                default:
+                    session.Tokens = fresh!;                               // rotation: from now on only the NEW refresh token exists
+                    log.LogInformation("Access token refreshed (refresh token rotated: {Rotated})", fresh!.RefreshToken != tokens.RefreshToken);
+                    return (TokenOutcome.Ok, fresh!.AccessToken, key);
+            }
+        }
+        finally { session.RefreshLock.Release(); }
+    }
+
+    /// <summary>Validates the cookie (data protection) and looks the session up in the store.</summary>
+    public async Task<(BffSession? Session, string? Key)> Resolve(HttpContext ctx)
+    {
+        var auth = await ctx.AuthenticateAsync(BffDefaults.CookieScheme);
+        if (!auth.Succeeded || auth.Properties is null || !auth.Properties.Items.TryGetValue(SessionStore.KeyItem, out var key) || key is null) return (null, null);
+        var session = store.Touch(key);
+        return session is null ? (null, null) : (session, key);
+    }
+
+    bool NeedsRefresh(TokenSet t) => t.ExpiresAt - clock.GetUtcNow() <= settings.RefreshSkew;
+
+    enum RefreshResult { Ok, Refused, Unreachable }
+
+    async Task<(RefreshResult, TokenSet?)> Refresh(TokenSet old, CancellationToken ct)
+    {
+        try
+        {
+            var options = oidc.Get(BffDefaults.OidcScheme);
+            var configuration = await options.ConfigurationManager!.GetConfigurationAsync(ct);
+            using var request = new HttpRequestMessage(HttpMethod.Post, configuration.TokenEndpoint)
+            {
+                Content = new FormUrlEncodedContent(new Dictionary<string, string>
+                {
+                    ["grant_type"] = "refresh_token",
+                    ["refresh_token"] = old.RefreshToken!,
+                    ["client_id"] = settings.ClientId,
+                    ["client_secret"] = settings.ClientSecret ?? "",
+                }),
+            };
+            using var response = await options.Backchannel.SendAsync(request, ct);
+            if ((int)response.StatusCode is >= 400 and < 500)
+            {
+                log.LogWarning("The identity provider refused a refresh ({Status}); ending the session", (int)response.StatusCode);
+                return (RefreshResult.Refused, null);
+            }
+            response.EnsureSuccessStatusCode();
+
+            using var doc = JsonDocument.Parse(await response.Content.ReadAsStringAsync(ct));
+            var root = doc.RootElement;
+            var access = root.GetProperty("access_token").GetString()!;
+            var refresh = root.TryGetProperty("refresh_token", out var r) && r.ValueKind == JsonValueKind.String ? r.GetString() : old.RefreshToken;   // IdP without rotation: keep using the old one
+            var seconds = root.TryGetProperty("expires_in", out var e) && e.TryGetInt32(out var s) ? s : 300;
+            return (RefreshResult.Ok, new TokenSet(access, refresh, clock.GetUtcNow().AddSeconds(seconds)));
+        }
+        catch (Exception ex) when ((ex is HttpRequestException or TaskCanceledException or JsonException or KeyNotFoundException or InvalidOperationException) && !ct.IsCancellationRequested)
+        {
+            log.LogWarning(ex, "Could not refresh the access token");
+            return (RefreshResult.Unreachable, null);
+        }
+    }
+}
