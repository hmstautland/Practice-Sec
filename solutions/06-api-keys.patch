diff --color -ruN -x bin -x obj -x dist -x node_modules -x certs -x '*.log' mid06/backend/src/SecLab.Api/Endpoints/ApiKeys.cs sol06/backend/src/SecLab.Api/Endpoints/ApiKeys.cs
--- a/backend/src/SecLab.Api/Endpoints/ApiKeys.cs	1970-01-01 01:00:00.000000000 +0100
+++ b/backend/src/SecLab.Api/Endpoints/ApiKeys.cs	2026-09-30 11:22:11.071995736 +0200
@@ -0,0 +1,86 @@
+using System.Security.Claims;
+using System.Security.Cryptography;
+using Microsoft.EntityFrameworkCore;
+using SecLab.Api.Authorization;
+using SecLab.Api.Data;
+using SecLab.Api.Models;
+
+namespace SecLab.Api.Endpoints;
+
+public static class ApiKeys
+{
+    const string Alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
+
+    public static void Map(RouteGroupBuilder api)
+    {
+        // ---- key management: signed-in USERS only (default JWT policy); a key can never mint or list keys ----
+        var keys = api.MapGroup("/keys");
+
+        keys.MapPost("/", async (CreateKey req, ClaimsPrincipal me, AppDbContext db) =>
+        {
+            if (me.LocalId() is not { } uid) return Results.Unauthorized();
+            var errors = new Dictionary<string, string[]>();
+            if (string.IsNullOrWhiteSpace(req.Name) || req.Name.Length > 100) errors["name"] = ["1-100 characters"];
+            if (ApiKeyDefaults.Rank(req.Level) == 0) errors["level"] = ["read, write or admin"];
+            if (req.ExpiresInSeconds is <= 0) errors["expiresInSeconds"] = ["must be positive"];
+            if (errors.Count > 0) return Results.ValidationProblem(errors);
+            if (req.Level == "admin" && !me.IsInRole("Admin")) return Results.Forbid();   // you cannot hand out more power than you have
+
+            var prefix = RandomNumberGenerator.GetString(Alphabet, 8);
+            var secret = RandomNumberGenerator.GetString(Alphabet, 40);                    // ~238 bits from a CSPRNG
+            var entity = new ApiKey
+            {
+                OwnerId = uid, Name = req.Name!, Prefix = prefix, KeyHash = ApiKeyDefaults.Hash(secret), Level = req.Level!,
+                ExpiresAt = req.ExpiresInSeconds is { } s ? DateTime.UtcNow.AddSeconds(s) : null,
+            };
+            db.ApiKeys.Add(entity);
+            await db.SaveChangesAsync();
+
+            // The only time the full key exists outside the client's hands.
+            return Results.Created($"/api/keys/{entity.Id}", new { id = entity.Id, apiKey = $"sl_{prefix}_{secret}", entity.Prefix, entity.Level, entity.ExpiresAt });
+        });
+
+        keys.MapGet("/", async (ClaimsPrincipal me, AppDbContext db) =>
+        {
+            if (me.LocalId() is not { } uid) return Results.Unauthorized();
+            return Results.Ok(await db.ApiKeys.Where(k => k.OwnerId == uid).OrderByDescending(k => k.CreatedAt)
+                .Select(k => new { k.Id, k.Name, k.Prefix, k.Level, k.CreatedAt, k.ExpiresAt, k.RevokedAt, k.LastUsedAt }).ToListAsync());
+        });
+
+        keys.MapDelete("/{id:int}", async (int id, ClaimsPrincipal me, AppDbContext db) =>
+        {
+            if (me.LocalId() is not { } uid) return Results.Unauthorized();
+            var key = await db.ApiKeys.FindAsync(id);
+            if (key is null) return Results.NotFound();
+            if (key.OwnerId != uid && !me.IsInRole("Admin")) return Results.Forbid();
+            key.RevokedAt ??= DateTime.UtcNow;
+            await db.SaveChangesAsync();
+            return Results.NoContent();
+        });
+
+        // ---- partner API: API keys only (each policy names the ApiKey scheme) ----
+        var partner = api.MapGroup("/partner");
+
+        partner.MapGet("/blogs", async (AppDbContext db) => Results.Ok(await Api.ToViews(db, db.Blogs.OrderByDescending(b => b.CreatedAt))))
+            .RequireAuthorization("ApiKey:read");
+
+        partner.MapPost("/blogs", async (PartnerBlog req, ClaimsPrincipal caller, AppDbContext db) =>
+        {
+            if (string.IsNullOrWhiteSpace(req.Title) || string.IsNullOrWhiteSpace(req.Body))
+                return Results.ValidationProblem(new Dictionary<string, string[]> { ["title"] = ["title and body are required"] });
+            var blog = new Blog { AuthorId = caller.LocalId()!.Value, Title = req.Title, Body = req.Body };   // author = the key's owner
+            db.Blogs.Add(blog);
+            await db.SaveChangesAsync();
+            return Results.Created($"/api/blogs/{blog.Id}", new { blog.Id });
+        }).RequireAuthorization("ApiKey:write");
+
+        partner.MapDelete("/blogs/{id:int}", async (int id, AppDbContext db) =>
+        {
+            await db.BlogLikes.Where(l => l.BlogId == id).ExecuteDeleteAsync();
+            return await db.Blogs.Where(b => b.Id == id).ExecuteDeleteAsync() == 0 ? Results.NotFound() : Results.NoContent();
+        }).RequireAuthorization("ApiKey:admin");
+    }
+
+    public record CreateKey(string? Name, string? Level, int? ExpiresInSeconds);
+    public record PartnerBlog(string? Title, string? Body);
+}
