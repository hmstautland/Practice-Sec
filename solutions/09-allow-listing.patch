+++ b/backend/src/SecLab.Api/Endpoints/Tools.cs	2026-09-30 11:45:16.374547090 +0200
@@ -0,0 +1,54 @@
+using System.Net;
+using System.Text;
+using System.Text.RegularExpressions;
+using SecLab.Api.Security;
+
+namespace SecLab.Api.Endpoints;
+
+public static partial class Tools
+{
+    const int MaxBytes = 1024 * 1024;
+
+    [GeneratedRegex("<title[^>]*>(.*?)</title>", RegexOptions.IgnoreCase | RegexOptions.Singleline, matchTimeoutMilliseconds: 500)]
+    private static partial Regex TitleRegex();
+
+    public static void Map(RouteGroupBuilder api, IConfiguration config)
+    {
+        var allowed = config.GetSection("Outbound:AllowedHosts").Get<string[]>() ?? [];
+
+        api.MapPost("/tools/link-preview", async (LinkPreviewRequest req, IHttpClientFactory clients, CancellationToken ct) =>
+        {
+            if (!OutboundUrlPolicy.TryValidate(req.Url, allowed, out var uri))
+                return Results.ValidationProblem(new Dictionary<string, string[]> { ["url"] = ["URL is not allowed"] });
+
+            try
+            {
+                using var response = await clients.CreateClient("outbound").GetAsync(uri, HttpCompletionOption.ResponseHeadersRead, ct);
+                if (response.StatusCode is >= HttpStatusCode.MultipleChoices and < HttpStatusCode.BadRequest)
+                    return Results.Problem("The site redirected; redirects are not followed.", statusCode: StatusCodes.Status502BadGateway);
+                if (!response.IsSuccessStatusCode) return Results.Problem("The site did not answer successfully.", statusCode: StatusCodes.Status502BadGateway);
+
+                await using var stream = await response.Content.ReadAsStreamAsync(ct);
+                var buffer = new byte[MaxBytes + 1];
+                var read = 0;
+                while (read < buffer.Length)
+                {
+                    var n = await stream.ReadAsync(buffer.AsMemory(read), ct);
+                    if (n == 0) break;
+                    read += n;
+                }
+                if (read > MaxBytes) return Results.Problem("The response is too large.", statusCode: StatusCodes.Status502BadGateway);
+
+                var m = TitleRegex().Match(Encoding.UTF8.GetString(buffer, 0, read));
+                var title = m.Success ? Regex.Replace(WebUtility.HtmlDecode(m.Groups[1].Value), @"\s+", " ").Trim() : null;
+                return Results.Ok(new { url = uri!.ToString(), title });
+            }
+            catch (Exception e) when (e is HttpRequestException or TaskCanceledException)
+            {
+                return Results.Problem("The site could not be reached.", statusCode: StatusCodes.Status502BadGateway);
+            }
+        });
+    }
+
+    public record LinkPreviewRequest(string? Url);
+}
