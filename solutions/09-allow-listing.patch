--- a/backend/src/SecLab.Api/Security/AdminNetwork.cs	1970-01-01 01:00:00.000000000 +0100
+++ b/backend/src/SecLab.Api/Security/AdminNetwork.cs	2026-09-30 11:45:16.372582789 +0200
@@ -0,0 +1,21 @@
+using System.Net;
+using Microsoft.AspNetCore.Authorization;
+
+namespace SecLab.Api.Security;
+
+/// <summary>Admin functions are reachable only from listed networks (CIDR), in addition to the Admin role.</summary>
+public class AdminNetworkRequirement : IAuthorizationRequirement;
+
+public class AdminNetworkHandler(IConfiguration config) : AuthorizationHandler<AdminNetworkRequirement>
+{
+    readonly IPNetwork[] _networks = (config.GetSection("Admin:AllowedNetworks").Get<string[]>() ?? []).Select(IPNetwork.Parse).ToArray();
+
+    protected override Task HandleRequirementAsync(AuthorizationHandlerContext context, AdminNetworkRequirement requirement)
+    {
+        var ip = (context.Resource as HttpContext)?.Connection.RemoteIpAddress;
+        if (ip is null) return Task.CompletedTask;                       // unknown origin: deny
+        if (ip.IsIPv4MappedToIPv6) ip = ip.MapToIPv4();                  // ::ffff:127.0.0.1 == 127.0.0.1
+        if (_networks.Any(n => n.Contains(ip))) context.Succeed(requirement);
+        return Task.CompletedTask;
+    }
+}
