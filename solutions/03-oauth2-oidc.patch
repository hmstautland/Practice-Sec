+import { UserManager, WebStorageStateStore } from 'oidc-client-ts'
+
+// Authorization Code flow with PKCE against Keycloak. The SPA is a *public* client: no client secret.
+export const userManager = new UserManager({
+  authority: 'http://localhost:8081/realms/seclab',
+  client_id: 'seclab-spa',
+  redirect_uri: `${window.location.origin}/callback`,
+  post_logout_redirect_uri: window.location.origin,
+  response_type: 'code',
+  scope: 'openid profile email',
+  // Tokens live in sessionStorage (gone when the tab closes). Still readable by any script running in the
+  // page (XSS) - see the token-storage discussion in docs/03; a BFF avoids it.
+  userStore: new WebStorageStateStore({ store: window.sessionStorage }),
+})
