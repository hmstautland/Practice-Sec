--- a/docs/init-database.sh	1970-01-01 01:00:00.000000000 +0100
+++ b/docs/init-database.sh	2026-10-04 20:56:02.023677007 +0200
@@ -0,0 +1,19 @@
+#!/usr/bin/env bash
+# One-time (and idempotent) database setup after `docker compose up -d sqlserver`:
+#   1. as sa: create the database, the logins seclab_migrator / seclab_app and their rights   (infra/sql/init.sql)
+#   2. as seclab_migrator: apply the EF Core migrations                                       (the app never does this itself)
+# Requires .env (bash docs/init-secrets.sh), the container running, and the .NET 10 SDK on PATH.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+set -a; . ./.env; set +a
+SQL=(docker exec -i "${SQL_CONTAINER:-seclab-sql}" /opt/mssql-tools18/bin/sqlcmd -C -S localhost -b)
+
+echo "waiting for SQL Server ..."
+for _ in $(seq 1 60); do "${SQL[@]}" -U sa -P "$MSSQL_SA_PASSWORD" -Q "SELECT 1" >/dev/null 2>&1 && break; sleep 2; done
+
+"${SQL[@]}" -U sa -P "$MSSQL_SA_PASSWORD" -v APP_PASSWORD="$SECLAB_APP_PASSWORD" MIGRATOR_PASSWORD="$SECLAB_MIGRATOR_PASSWORD" < infra/sql/init.sql
+echo "logins and permissions are in place"
+
+dotnet tool restore >/dev/null
+dotnet ef database update --project backend/src/SecLab.Api --connection "$ConnectionStrings__Migrator"
+echo "migrations applied"
