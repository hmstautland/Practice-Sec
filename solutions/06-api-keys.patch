--- a/backend/src/SecLab.Api/Authorization/ApiKeyAuthentication.cs	1970-01-01 01:00:00.000000000 +0100
+++ b/backend/src/SecLab.Api/Authorization/ApiKeyAuthentication.cs	2026-09-30 11:23:08.365162365 +0200
@@ -0,0 +1,75 @@
+using System.Security.Claims;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Encodings.Web;
+using System.Text.RegularExpressions;
+using Microsoft.AspNetCore.Authentication;
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Options;
+using SecLab.Api.Data;
+
+namespace SecLab.Api.Authorization;
+
+public static class ApiKeyDefaults
+{
+    public const string Scheme = "ApiKey";
+    public const string Header = "X-Api-Key";
+    public const string LevelClaim = "api_level";
+    public static readonly string[] Levels = ["read", "write", "admin"];          // ordered: each includes the ones before it
+    public static int Rank(string? level) => Array.IndexOf(Levels, level) + 1;     // 0 = unknown
+
+    public static byte[] Hash(string secret) => SHA256.HashData(Encoding.UTF8.GetBytes(secret));
+}
+
+/// <summary>Authenticates machine clients by the X-Api-Key header. Only the hash of the secret is stored.</summary>
+public partial class ApiKeyAuthHandler(IOptionsMonitor<AuthenticationSchemeOptions> options, ILoggerFactory logger, UrlEncoder encoder)
+    : AuthenticationHandler<AuthenticationSchemeOptions>(options, logger, encoder)
+{
+    [GeneratedRegex("^sl_(?<prefix>[A-Za-z0-9]{8})_(?<secret>[A-Za-z0-9]{32,128})$")]
+    private static partial Regex KeyFormat();
+
+    protected override async Task<AuthenticateResult> HandleAuthenticateAsync()
+    {
+        if (!Request.Headers.TryGetValue(ApiKeyDefaults.Header, out var header) || header.Count != 1)
+            return AuthenticateResult.NoResult();
+
+        var m = KeyFormat().Match(header.ToString());
+        if (!m.Success) return AuthenticateResult.Fail("invalid key");
+
+        var db = Context.RequestServices.GetRequiredService<AppDbContext>();
+        var prefix = m.Groups["prefix"].Value;
+        var key = await db.ApiKeys.AsNoTracking().FirstOrDefaultAsync(k => k.Prefix == prefix);
+
+        // Same work whether or not the prefix exists: always compare against *something*.
+        var stored = key?.KeyHash ?? new byte[32];
+        var matches = CryptographicOperations.FixedTimeEquals(ApiKeyDefaults.Hash(m.Groups["secret"].Value), stored);
+        if (key is null || !matches || key.RevokedAt is not null || key.ExpiresAt <= DateTime.UtcNow)
+            return AuthenticateResult.Fail("invalid key");
+
+        if (key.LastUsedAt is null || key.LastUsedAt < DateTime.UtcNow.AddMinutes(-1))
+            await db.ApiKeys.Where(k => k.Id == key.Id).ExecuteUpdateAsync(s => s.SetProperty(k => k.LastUsedAt, DateTime.UtcNow));
+
+        var identity = new ClaimsIdentity(
+        [
+            new Claim(ClaimTypes.NameIdentifier, $"apikey:{key.Id}"),
+            new Claim(LocalUserClaims.LocalUserId, key.OwnerId.ToString()),      // acts on behalf of the key's owner
+            new Claim(ApiKeyDefaults.LevelClaim, key.Level),
+            new Claim("api_key_id", key.Id.ToString()),
+        ], Scheme.Name);
+        return AuthenticateResult.Success(new AuthenticationTicket(new ClaimsPrincipal(identity), Scheme.Name));
+    }
+}
+
+public static class ApiKeyPolicies
+{
+    public static AuthorizationBuilder AddApiKeyPolicies(this AuthorizationBuilder b)
+    {
+        foreach (var level in ApiKeyDefaults.Levels)
+            b.AddPolicy("ApiKey:" + level, p => p
+                .AddAuthenticationSchemes(ApiKeyDefaults.Scheme)                 // this policy authenticates with the key scheme only
+                .RequireAuthenticatedUser()
+                .RequireAssertion(ctx => ApiKeyDefaults.Rank(ctx.User.FindFirst(ApiKeyDefaults.LevelClaim)?.Value) >= ApiKeyDefaults.Rank(level)));
+        return b;
+    }
+}
