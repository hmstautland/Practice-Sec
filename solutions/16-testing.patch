+    // ---------- API key helpers ----------
+    [Fact]
+    public void Key_hash_is_a_deterministic_32_byte_digest_that_does_not_contain_the_secret()
+    {
+        var a = ApiKeyDefaults.Hash("s3cret-value");
+        Assert.Equal(32, a.Length);
+        Assert.Equal(a, ApiKeyDefaults.Hash("s3cret-value"));
+        Assert.NotEqual(a, ApiKeyDefaults.Hash("s3cret-valuf"));
+        Assert.NotEqual(a, ApiKeyDefaults.Hash("S3CRET-VALUE"));
+        Assert.DoesNotContain("s3cret", Convert.ToHexString(a), StringComparison.OrdinalIgnoreCase);
+        Assert.Equal("E3B0C44298FC1C149AFBF4C8996FB92427AE41E4649B934CA495991B7852B855", Convert.ToHexString(ApiKeyDefaults.Hash("")));   // known-answer test: SHA-256 of ""
+    }
