+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using System.Text.RegularExpressions;
+using Microsoft.AspNetCore.Mvc.Testing;
+using SecLab.Api.Models;
+using Xunit;
+
+namespace SecLab.Api.Tests.Learner;
+
+// Step 16 - contract tests: the SHAPE of what the API says, written down and guarded.
+// 1. Snapshots (Learner/Snapshots/*.json): property paths and JSON types of each important response. A new, renamed or removed
+//    field fails the test, so a response can only change on purpose and in a reviewed diff. Update: SECLAB_UPDATE_SNAPSHOTS=1.
+// 2. Invariants over every sample: no password / hash / lock-out / credential property is ever serialised.
+// 3. Every error, whoever produced it, is problem details: same shape, correlation id, nothing about the inside.
+// The API has no OpenAPI document (step 13 keeps it that way), so the contract is whatever the clients actually receive.
+[Trait("Step", "16")]
+[Trait("Kind", "Contract")]
+public class ContractTests(WebApplicationFactory<Program> factory) : IClassFixture<WebApplicationFactory<Program>>, IDisposable
+{
+    readonly EnvScope _env = new(("RateLimiting__Anonymous", "100000"), ("RateLimiting__User", "100000"), ("RateLimiting__Login", "100000"));
+    Harness? _h;
+    Harness H => _h ??= new Harness(factory);
+    public void Dispose() { _h?.Dispose(); _env.Dispose(); }
+
+    static readonly string SnapshotDir = Repo.Path_("backend/tests/SecLab.Api.Tests/Learner/Snapshots");
+
+    // ---------------- sampling: one real response per interesting endpoint ----------------
+    static async Task<JsonElement> Body(HttpResponseMessage res, HttpStatusCode expected)
+    {
+        var text = await res.Content.ReadAsStringAsync();
+        Assert.True(res.StatusCode == expected, $"expected {(int)expected}, got {(int)res.StatusCode}: {text}");
+        return JsonDocument.Parse(text).RootElement.Clone();
+    }
+
+    async Task<Dictionary<string, JsonElement>> Samples()
+    {
+        var owner = H.NewPerson(); var friend = H.NewPerson(); var stranger = H.NewPerson(); var admin = H.NewPerson("Admin");
+        H.InDb(db =>
+        {
+            db.Friendships.Add(new Friendship { UserId = owner.Id, FriendId = friend.Id });
+            db.Friendships.Add(new Friendship { UserId = friend.Id, FriendId = owner.Id });
+            db.SaveChanges(); return 0;
+        });
+        var blog = await Body(await owner.Http.PostAsJsonAsync("/api/blogs", new { title = "t", body = "<p>b</p>" }), HttpStatusCode.Created);
+        var name = "c" + Guid.NewGuid().ToString("N")[..10];
+        var anon = H.Anonymous();
+
+        var s = new Dictionary<string, JsonElement>
+        {
+            ["register"] = await Body(await anon.PostAsJsonAsync("/api/auth/register", new { username = name, password = "correct-horse-battery", displayName = "C", email = $"{name}@example.com" }), HttpStatusCode.Created),
+            ["login"] = await Body(await anon.PostAsJsonAsync("/api/auth/login", new { username = name, password = "correct-horse-battery" }), HttpStatusCode.OK),
+            ["me"] = await Body(await owner.Http.GetAsync("/api/me"), HttpStatusCode.OK),
+            ["user-owner-view"] = await Body(await owner.Http.GetAsync($"/api/users/{owner.Id}"), HttpStatusCode.OK),
+            ["user-friend-view"] = await Body(await friend.Http.GetAsync($"/api/users/{owner.Id}"), HttpStatusCode.OK),
+            ["user-public-view"] = await Body(await stranger.Http.GetAsync($"/api/users/{owner.Id}"), HttpStatusCode.OK),
+            ["friends"] = await Body(await owner.Http.GetAsync($"/api/users/{owner.Id}/friends"), HttpStatusCode.OK),
+            ["blogs-v1"] = await Body(await owner.Http.GetAsync("/api/blogs"), HttpStatusCode.OK),
+            ["blogs-v2"] = await Body(await owner.Http.GetAsync("/api/blogs?api-version=2.0"), HttpStatusCode.OK),
+            ["blog-created"] = blog,
+            ["timeline"] = await Body(await friend.Http.GetAsync("/api/timeline"), HttpStatusCode.OK),
+            ["admin-users"] = await Body(await admin.Http.GetAsync("/api/admin/users"), HttpStatusCode.OK),
+            ["key-created"] = await Body(await owner.Http.PostAsJsonAsync("/api/keys", new { name = "contract", level = "read" }), HttpStatusCode.Created),
+            ["keys-list"] = await Body(await owner.Http.GetAsync("/api/keys"), HttpStatusCode.OK),
+        };
+        return s;
+    }
+
+    // ---------------- 1. snapshots ----------------
+    /// <summary>"$.items[].likes" -> "number": every property path with its JSON type(s); arrays are merged over all their elements.</summary>
+    internal static SortedDictionary<string, string> Shape(JsonElement e)
+    {
+        var map = new SortedDictionary<string, HashSet<string>>();
+        void Walk(JsonElement x, string path)
+        {
+            Add(path, x.ValueKind switch { JsonValueKind.True or JsonValueKind.False => "boolean", var k => k.ToString().ToLowerInvariant() });
+            if (x.ValueKind == JsonValueKind.Object) foreach (var p in x.EnumerateObject()) Walk(p.Value, path + "." + p.Name);
+            else if (x.ValueKind == JsonValueKind.Array) foreach (var i in x.EnumerateArray()) Walk(i, path + "[]");
+        }
+        void Add(string path, string type) { if (!map.TryGetValue(path, out var set)) map[path] = set = []; set.Add(type); }
+        Walk(e, "$");
+        return new(map.ToDictionary(kv => kv.Key, kv => string.Join("|", kv.Value.Order())));
+    }
+
+    static readonly string[] SnapshotNames =
+        ["register", "login", "me", "user-owner-view", "user-friend-view", "user-public-view", "friends", "blogs-v1", "blogs-v2", "blog-created", "timeline", "admin-users", "key-created", "keys-list"];
+
+    [Fact]
+    public async Task Responses_have_exactly_the_recorded_shape()
+    {
+        var samples = await Samples();
+        var update = Environment.GetEnvironmentVariable("SECLAB_UPDATE_SNAPSHOTS") == "1";
+        var problems = new List<string>();
+        foreach (var name in SnapshotNames)
+        {
+            var actual = Shape(samples[name]);
+            var file = Path.Combine(SnapshotDir, name + ".json");
+            if (update) { Directory.CreateDirectory(SnapshotDir); File.WriteAllText(file, JsonSerializer.Serialize(actual, new JsonSerializerOptions { WriteIndented = true }) + "\n"); continue; }
+            if (!File.Exists(file)) { problems.Add($"{name}: no snapshot (run once with SECLAB_UPDATE_SNAPSHOTS=1, review the file, commit it)"); continue; }
+            var expected = JsonSerializer.Deserialize<Dictionary<string, string>>(File.ReadAllText(file))!;
+            foreach (var (path, type) in actual) if (!expected.TryGetValue(path, out var t)) problems.Add($"{name}: NEW   {path} ({type})"); else if (t != type) problems.Add($"{name}: TYPE  {path} {t} -> {type}");
+            foreach (var path in expected.Keys.Except(actual.Keys)) problems.Add($"{name}: GONE  {path}");
+        }
+        Assert.True(problems.Count == 0, "the contract changed:\n" + string.Join("\n", problems));
+    }
+
+    // ---------------- 2. what must never be serialised ----------------
+    static readonly Regex Forbidden = new(@"(?i)(pass(word|wd)?|hash|salt|secret|lockout|failedlogin|publickey|credentialid|userhandle|signcount|token|apikey)");
+
+    /// <summary>Known, documented exceptions: sample name -> property that is allowed to match.</summary>
+    static readonly (string Sample, string Path)[] Exceptions =
+    [
+        ("key-created", "$.apiKey"),     // the one moment a new key is shown (docs/06)
+        ("login", "$.token"),            // LEGACY (see docs/03): /api/auth/login still returns a placeholder 'token' (the user id). Delete this line when that goes away.
+    ];
+
+    [Fact]
+    public async Task No_response_ever_contains_a_property_that_looks_like_a_credential_or_a_lock_out_detail()
+    {
+        var offenders = new List<string>();
+        foreach (var (name, json) in await Samples())
+            foreach (var path in Shape(json).Keys)
+            {
+                var leaf = path[(path.LastIndexOfAny(['.', ']']) + 1)..];
+                if (Forbidden.IsMatch(leaf) && !Exceptions.Contains((name, path))) offenders.Add($"{name}: {path}");
+            }
+        Assert.True(offenders.Count == 0, "sensitive-looking properties in responses:\n" + string.Join("\n", offenders));
+    }
+
+    [Fact]
+    public void The_forbidden_pattern_itself_catches_the_names_it_is_meant_to_catch()
+    {
+        foreach (var bad in new[] { "password", "Password", "passwordHash", "passwordIsHashed", "keyHash", "failedLoginCount", "lockoutEnd", "apiKey", "accessToken", "publicKey", "signCount", "userHandle", "salt", "clientSecret" })
+            Assert.Matches(Forbidden, bad);
+        foreach (var fine in new[] { "id", "username", "displayName", "email", "phone", "address", "bio", "role", "createdAt", "likes", "title", "body" })
+            Assert.DoesNotMatch(Forbidden, fine);
+    }
+
+    [Fact]
+    public void The_entity_classes_that_hold_secrets_are_not_the_contract_types()
+    {
+        // The returned record types must not expose entity fields that hold secrets; the User entity itself has them.
+        var secrets = typeof(User).GetProperties().Select(p => p.Name).Where(n => Forbidden.IsMatch(n)).Order().ToArray();
+        Assert.Equal(new[] { "FailedLoginCount", "LockoutEnd", "Password", "PasswordIsHashed" }, secrets);
+        foreach (var contract in new[] { typeof(Endpoints.Api.PublicProfile), typeof(Endpoints.Api.FriendProfile), typeof(Endpoints.Api.FullProfile), typeof(Endpoints.Api.BlogView) })
+            Assert.Empty(contract.GetProperties().Select(p => p.Name).Intersect(secrets));
+    }
+
+    // ---------------- 3. errors are problem details ----------------
+    async Task<List<(string What, int Expected, HttpResponseMessage Res)>> ErrorSamples()
+    {
+        var p = H.NewPerson(); var admin = H.NewPerson("Admin"); var name = "e" + Guid.NewGuid().ToString("N")[..10];
+        await H.Anonymous().PostAsJsonAsync("/api/auth/register", new { username = name, password = "correct-horse-battery", displayName = "E", email = $"{name}@example.com" });
+        var textPlain = new HttpRequestMessage(HttpMethod.Post, "/api/blogs") { Content = new StringContent("title=x", System.Text.Encoding.UTF8, "text/plain") };
+        var patch = new HttpRequestMessage(HttpMethod.Patch, "/api/blogs");
+        return
+        [
+            ("400 validation", 400, await p.Http.PostAsJsonAsync("/api/blogs", new { title = "", body = "" })),
+            ("400 bad page", 400, await p.Http.GetAsync("/api/blogs?api-version=2.0&pageSize=9999")),
+            ("401 anonymous", 401, await H.Anonymous().GetAsync("/api/me")),
+            ("401 login", 401, await H.Anonymous().PostAsJsonAsync("/api/auth/login", new { username = name, password = "wrong-password-xx" })),
+            ("403 forbidden", 403, await p.Http.GetAsync("/api/admin/users")),
+            ("404 no route", 404, await p.Http.GetAsync("/api/does-not-exist")),
+            ("404 no object", 404, await p.Http.GetAsync("/api/users/2000000000")),
+            ("405 method", 405, await p.Http.SendAsync(patch)),
+            ("409 conflict", 409, await H.Anonymous().PostAsJsonAsync("/api/auth/register", new { username = name, password = "correct-horse-battery", displayName = "E", email = $"{name}@example.com" })),
+            ("415 media type", 415, await p.Http.SendAsync(textPlain)),
+            ("500 crash", 500, await admin.Http.GetAsync("/api/debug/crash")),
+        ];
+    }
+
+    [Fact]
+    public async Task Every_error_is_problem_details_with_a_correlation_id_and_nothing_about_the_inside()
+    {
+        foreach (var (what, expected, res) in await ErrorSamples())
+        {
+            Assert.True((int)res.StatusCode == expected, $"{what}: got {(int)res.StatusCode}");
+            Assert.True(res.Content.Headers.ContentType?.MediaType == "application/problem+json", $"{what}: content type {res.Content.Headers.ContentType}");
+            var text = await res.Content.ReadAsStringAsync();
+            var json = JsonDocument.Parse(text).RootElement;
+            Assert.Equal(expected, json.GetProperty("status").GetInt32());
+            Assert.False(string.IsNullOrWhiteSpace(json.GetProperty("title").GetString()), $"{what}: title");
+            Assert.False(string.IsNullOrWhiteSpace(json.GetProperty("traceId").GetString()), $"{what}: traceId");
+            Assert.True(res.Headers.Contains("X-Trace-Id"), $"{what}: X-Trace-Id header");
+
+            var names = Shape(json).Keys.Select(k => k.TrimStart('$', '.')).Where(k => k.Length > 0 && !k.Contains('.')).ToHashSet(StringComparer.OrdinalIgnoreCase);
+            Assert.Subset(new HashSet<string>(["type", "title", "status", "detail", "instance", "traceId", "errors", "errors[]"], StringComparer.OrdinalIgnoreCase), names);
+            foreach (var leak in new[] { "stackTrace", "exception", "Exception", " at SecLab", "Boom", "Server=", "User Id", ".cs:line", "System." }) Assert.DoesNotContain(leak, text);
+        }
+    }
+
+    [Fact]
+    public async Task Validation_errors_name_the_fields_that_failed_and_nothing_else()
+    {
+        var p = H.NewPerson();
+        var json = await Body(await p.Http.PostAsJsonAsync("/api/blogs", new { title = "", body = "" }), HttpStatusCode.BadRequest);
+        var fields = json.GetProperty("errors").EnumerateObject().Select(x => x.Name).Order(StringComparer.OrdinalIgnoreCase).ToArray();
+        Assert.Equal(new[] { "body", "title" }, fields.Select(f => f.ToLowerInvariant()));
+    }
+
+    // ---------------- versions are part of the contract ----------------
+    [Fact]
+    public async Task Version_1_is_a_bare_array_and_version_2_is_a_paged_envelope()
+    {
+        var s = await Samples();
+        Assert.Equal(JsonValueKind.Array, s["blogs-v1"].ValueKind);
+        Assert.Equal(JsonValueKind.Object, s["blogs-v2"].ValueKind);
+        Assert.Equal(new[] { "items", "page", "pageSize", "total" }, s["blogs-v2"].EnumerateObject().Select(x => x.Name).Order().ToArray());
+        Assert.True(s["blogs-v2"].GetProperty("items").GetArrayLength() <= 20);
+    }
+}
