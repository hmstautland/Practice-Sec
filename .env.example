# Copy to .env (git-ignored) and fill in with strong, unique values - or generate them: bash docs/init-secrets.sh
# docker compose reads this file automatically; export it for the API and the tests:  set -a; source .env; set +a
MSSQL_SA_PASSWORD=
SECLAB_APP_PASSWORD=
SECLAB_MIGRATOR_PASSWORD=
ConnectionStrings__Default=
ConnectionStrings__Migrator=
# Step 17: the BFF's client secret. Keycloak generates it; copy it here with:  bash docs/init-bff-secret.sh
Bff__ClientSecret=
