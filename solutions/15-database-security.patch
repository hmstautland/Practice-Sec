diff --color -ruN -x bin -x obj -x dist -x node_modules -x certs -x '*.log' -x '*.png' -x .env mid15/infra/sql/init.sql sol15/infra/sql/init.sql
--- a/infra/sql/init.sql	1970-01-01 01:00:00.000000000 +0100
+++ b/infra/sql/init.sql	2026-10-04 20:55:36.921756015 +0200
@@ -0,0 +1,29 @@
+-- Creates the database, the two identities and their rights. Idempotent: running it again rotates the passwords.
+-- Run by docs/init-database.sh as sa with:  sqlcmd -v APP_PASSWORD=... MIGRATOR_PASSWORD=... -i infra/sql/init.sql
+-- Two identities, because "can change the schema" and "runs all day on user input" must not be the same power:
+--   seclab_migrator  schema owner, used only by the migration step (never by the running app)
+--   seclab_app       the web app: read/write rows in the application schema, nothing else
+:on error exit
+IF DB_ID('SecLab') IS NULL CREATE DATABASE SecLab;
+GO
+IF SUSER_ID('seclab_app') IS NULL
+    CREATE LOGIN seclab_app WITH PASSWORD = '$(APP_PASSWORD)', DEFAULT_DATABASE = SecLab, CHECK_POLICY = ON, CHECK_EXPIRATION = OFF;
+ELSE
+    ALTER LOGIN seclab_app WITH PASSWORD = '$(APP_PASSWORD)';
+IF SUSER_ID('seclab_migrator') IS NULL
+    CREATE LOGIN seclab_migrator WITH PASSWORD = '$(MIGRATOR_PASSWORD)', DEFAULT_DATABASE = SecLab, CHECK_POLICY = ON, CHECK_EXPIRATION = OFF;
+ELSE
+    ALTER LOGIN seclab_migrator WITH PASSWORD = '$(MIGRATOR_PASSWORD)';
+GO
+USE SecLab;
+GO
+IF USER_ID('seclab_app') IS NULL CREATE USER seclab_app FOR LOGIN seclab_app WITH DEFAULT_SCHEMA = dbo;
+IF USER_ID('seclab_migrator') IS NULL CREATE USER seclab_migrator FOR LOGIN seclab_migrator WITH DEFAULT_SCHEMA = dbo;
+GO
+-- migrator: create/alter/drop objects, and read/write the migration history (and move data inside migrations); no server-level rights
+ALTER ROLE db_ddladmin ADD MEMBER seclab_migrator;
+ALTER ROLE db_datareader ADD MEMBER seclab_migrator;
+ALTER ROLE db_datawriter ADD MEMBER seclab_migrator;
+-- app: exactly the four row operations, on the application schema (this also covers tables a later migration adds). No DDL, no EXECUTE, no other schemas.
+GRANT SELECT, INSERT, UPDATE, DELETE ON SCHEMA::dbo TO seclab_app;
+GO
