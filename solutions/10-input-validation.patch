diff --color -ruN -x bin -x obj -x dist -x node_modules -x certs -x '*.log' -x '*.png' mid10/backend/src/SecLab.Api/Validation/ContentSanitizer.cs sol10/backend/src/SecLab.Api/Validation/ContentSanitizer.cs
--- a/backend/src/SecLab.Api/Validation/ContentSanitizer.cs	1970-01-01 01:00:00.000000000 +0100
+++ b/backend/src/SecLab.Api/Validation/ContentSanitizer.cs	2026-09-30 11:50:47.732516775 +0200
@@ -0,0 +1,28 @@
+using Ganss.Xss;
+
+namespace SecLab.Api.Validation;
+
+/// <summary>Blog bodies are user-supplied HTML. Keep a small allow-list of formatting; drop everything else.</summary>
+public class ContentSanitizer
+{
+    static readonly string[] Tags = ["p", "br", "b", "i", "u", "strong", "em", "ul", "ol", "li", "a", "code", "pre", "blockquote", "h1", "h2", "h3", "h4"];
+    static readonly string[] Schemes = ["https", "http", "mailto"];
+
+    readonly HtmlSanitizer _sanitizer = Build();
+
+    static HtmlSanitizer Build()
+    {
+        var s = new HtmlSanitizer();
+        s.AllowedTags.Clear(); foreach (var t in Tags) s.AllowedTags.Add(t);
+        s.AllowedAttributes.Clear(); s.AllowedAttributes.Add("href");          // no style, class, id, on*, src, target ...
+        s.AllowedSchemes.Clear(); foreach (var sc in Schemes) s.AllowedSchemes.Add(sc);
+        s.AllowedCssProperties.Clear();
+        s.PostProcessNode += (_, e) =>
+        {
+            if (e.Node is AngleSharp.Html.Dom.IHtmlAnchorElement a) a.SetAttribute("rel", "noopener noreferrer nofollow");
+        };
+        return s;
+    }
+
+    public string Clean(string html) => _sanitizer.Sanitize(html);
+}
diff --color -ruN -x bin -x obj -x dist -x node_modules -x certs -x '*.log' -x '*.png' mid10/backend/src/SecLab.Api/Validation/Contracts.cs sol10/backend/src/SecLab.Api/Validation/Contracts.cs
--- a/backend/src/SecLab.Api/Validation/Contracts.cs	1970-01-01 01:00:00.000000000 +0100
+++ b/backend/src/SecLab.Api/Validation/Contracts.cs	2026-09-30 11:50:47.730024019 +0200
@@ -0,0 +1,34 @@
+using System.ComponentModel.DataAnnotations;
+
+namespace SecLab.Api.Validation;
+
+// Every request body / parameter that crosses the API boundary is described here, with its limits.
+// Rule of thumb: allow-list the format, cap the length, reject - never "fix" - bad input.
+static class Rx
+{
+    public const string Username = "^[A-Za-z0-9_]{3,32}$";                           // ASCII only: no homoglyphs, no markup
+    public const string Email = @"^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$";
+    public const string PlainText = @"^[^<>]*$";                                     // names and titles are text, never markup
+    public const string Phone = @"^\+?[0-9 ()\-]{6,20}$";
+}
+
+public record RegisterRequest(
+    [property: Required, RegularExpression(Rx.Username)] string? Username,
+    [property: Required, StringLength(128, MinimumLength = 12)] string? Password,
+    [property: Required, StringLength(60, MinimumLength = 1), RegularExpression(Rx.PlainText)] string? DisplayName,
+    [property: Required, StringLength(254), RegularExpression(Rx.Email)] string? Email);
+
+public record UpdateProfile(
+    [property: StringLength(60, MinimumLength = 1), RegularExpression(Rx.PlainText)] string? DisplayName,
+    [property: StringLength(254), RegularExpression(Rx.Email)] string? Email,
+    [property: RegularExpression(Rx.Phone)] string? Phone,
+    [property: StringLength(200), RegularExpression(Rx.PlainText)] string? Address,
+    [property: StringLength(500), RegularExpression(Rx.PlainText)] string? Bio);
+
+public record CreateBlog(
+    [property: Required, StringLength(120, MinimumLength = 1), RegularExpression(Rx.PlainText)] string? Title,
+    [property: Required, StringLength(10_000, MinimumLength = 1)] string? Body);
+
+public record EditBlog(
+    [property: StringLength(120, MinimumLength = 1), RegularExpression(Rx.PlainText)] string? Title,
+    [property: StringLength(10_000, MinimumLength = 1)] string? Body);
