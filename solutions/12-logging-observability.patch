diff --color -ruN -x bin -x obj -x dist -x node_modules -x certs -x '*.log' -x '*.png' mid12/backend/src/SecLab.Api/Observability/Audit.cs sol12/backend/src/SecLab.Api/Observability/Audit.cs
--- a/backend/src/SecLab.Api/Observability/Audit.cs	1970-01-01 01:00:00.000000000 +0100
+++ b/backend/src/SecLab.Api/Observability/Audit.cs	2026-09-30 12:06:35.181235720 +0200
@@ -0,0 +1,121 @@
+using System.Diagnostics.Metrics;
+using System.Text;
+
+namespace SecLab.Api.Observability;
+
+/// <summary>
+/// Security events go to one dedicated category ("SecLab.Audit") with a fixed vocabulary of structured properties,
+/// so they can be routed, retained and alerted on separately from application noise.
+/// RULES: never log credentials or personal data beyond what an investigation needs; sanitise everything a user typed.
+/// </summary>
+public sealed class AuditLog(ILoggerFactory loggers, SecurityMetrics metrics)
+{
+    readonly ILogger _log = loggers.CreateLogger("SecLab.Audit");
+    public SecurityMetrics Metrics { get; } = metrics;
+
+    public static string Ip(HttpContext ctx)
+    {
+        var ip = ctx.Connection.RemoteIpAddress;
+        return ip is null ? "unknown" : (ip.IsIPv4MappedToIPv6 ? ip.MapToIPv4() : ip).ToString();
+    }
+
+    /// <summary>User-controlled text: no control characters (log forging, terminal escapes), bounded length.</summary>
+    public static string Clean(string? value, int max = 64)
+    {
+        if (string.IsNullOrEmpty(value)) return "";
+        var sb = new StringBuilder(Math.Min(value.Length, max));
+        foreach (var c in value)
+        {
+            if (sb.Length >= max) break;
+            if (!char.IsControl(c)) sb.Append(c);
+        }
+        return sb.ToString();
+    }
+
+    // ---- authentication ----
+    public void LoginFailed(HttpContext ctx, string? username, string reason)
+    {
+        Metrics.LoginFailures.Add(1, new KeyValuePair<string, object?>("reason", reason));
+        _log.LogWarning("Audit {Event}: user {Username} from {ClientIp}, reason {Reason}", "login.failed", Clean(username), Ip(ctx), reason);
+    }
+    public void LoginSucceeded(HttpContext ctx, int userId) =>
+        _log.LogInformation("Audit {Event}: user {UserId} from {ClientIp}", "login.succeeded", userId, Ip(ctx));
+    public void LoginLocked(HttpContext ctx, int userId)
+    {
+        Metrics.Lockouts.Add(1);
+        _log.LogWarning("Audit {Event}: user {UserId} from {ClientIp}", "login.locked", userId, Ip(ctx));
+    }
+    public void UserRegistered(HttpContext ctx, int userId) =>
+        _log.LogInformation("Audit {Event}: user {UserId} from {ClientIp}", "user.registered", userId, Ip(ctx));
+
+    // ---- keys and second factors ----
+    public void ApiKeyCreated(HttpContext ctx, int userId, int keyId, string level) =>
+        _log.LogInformation("Audit {Event}: user {UserId} key {KeyId} level {Level} from {ClientIp}", "apikey.created", userId, keyId, level, Ip(ctx));
+    public void ApiKeyRevoked(HttpContext ctx, int userId, int keyId) =>
+        _log.LogInformation("Audit {Event}: user {UserId} key {KeyId} from {ClientIp}", "apikey.revoked", userId, keyId, Ip(ctx));
+    public void ApiKeyRejected(HttpContext ctx, string reason)
+    {
+        Metrics.ApiKeyRejected.Add(1, new KeyValuePair<string, object?>("reason", reason));
+        _log.LogWarning("Audit {Event}: from {ClientIp}, reason {Reason}", "apikey.rejected", Ip(ctx), reason);
+    }
+    public void PasskeyRegistered(HttpContext ctx, int userId) =>
+        _log.LogInformation("Audit {Event}: user {UserId} from {ClientIp}", "passkey.registered", userId, Ip(ctx));
+    public void PasskeyFailed(HttpContext ctx, int userId, string stage) =>
+        _log.LogWarning("Audit {Event}: user {UserId} stage {Stage} from {ClientIp}", "passkey.failed", userId, stage, Ip(ctx));
+    public void StepUpGranted(HttpContext ctx, int userId) =>
+        _log.LogInformation("Audit {Event}: user {UserId} from {ClientIp}", "stepup.granted", userId, Ip(ctx));
+
+    // ---- privileged and destructive actions ----
+    public void RoleChanged(HttpContext ctx, int actorId, int targetId, string newRole) =>
+        _log.LogWarning("Audit {Event}: actor {UserId} changed user {TargetUserId} to {NewRole} from {ClientIp}", "role.changed", actorId, targetId, newRole, Ip(ctx));
+    public void AccountDeleted(HttpContext ctx, int userId) =>
+        _log.LogWarning("Audit {Event}: user {UserId} from {ClientIp}", "account.deleted", userId, Ip(ctx));
+
+    // ---- what the pipeline denied (see AuditMiddleware) ----
+    public void Denied(HttpContext ctx, string eventName, int? userId, string endpoint)
+    {
+        if (eventName == "authz.denied") Metrics.AuthzDenied.Add(1);
+        if (eventName == "ratelimit.rejected") Metrics.RateLimited.Add(1);
+        var level = eventName == "authn.required" ? LogLevel.Information : LogLevel.Warning;
+        _log.Log(level, "Audit {Event}: user {UserId} endpoint {Endpoint} from {ClientIp}", eventName, userId?.ToString() ?? "anonymous", Clean(endpoint, 120), Ip(ctx));
+    }
+}
+
+/// <summary>Counters for alerting. Tags are few and low-cardinality; NEVER add user names, IPs, emails or paths as tags.</summary>
+public sealed class SecurityMetrics
+{
+    public const string MeterName = "SecLab.Security";
+    public Counter<long> LoginFailures { get; }
+    public Counter<long> Lockouts { get; }
+    public Counter<long> AuthzDenied { get; }
+    public Counter<long> RateLimited { get; }
+    public Counter<long> ApiKeyRejected { get; }
+    public Counter<long> UnhandledErrors { get; }
+
+    public SecurityMetrics(IMeterFactory factory)
+    {
+        var m = factory.Create(MeterName);
+        LoginFailures = m.CreateCounter<long>("seclab.auth.login.failures", description: "Failed logins, by internal reason");
+        Lockouts = m.CreateCounter<long>("seclab.auth.lockouts", description: "Accounts locked after repeated failures");
+        AuthzDenied = m.CreateCounter<long>("seclab.authz.denied", description: "Requests answered 403");
+        RateLimited = m.CreateCounter<long>("seclab.ratelimit.rejected", description: "Requests answered 429");
+        ApiKeyRejected = m.CreateCounter<long>("seclab.apikey.rejected", description: "Invalid, revoked or expired API keys presented");
+        UnhandledErrors = m.CreateCounter<long>("seclab.errors.unhandled", description: "Unhandled exceptions (HTTP 5xx)");
+    }
+}
+
+/// <summary>Records what the pipeline refused - 401, 403 and 429 - whichever component refused it.</summary>
+public static class AuditMiddleware
+{
+    public static IApplicationBuilder UseSecurityAudit(this IApplicationBuilder app) =>
+        app.Use(async (ctx, next) =>
+        {
+            await next();
+            var status = ctx.Response.StatusCode;
+            if (status is not (401 or 403 or 429)) return;
+            var audit = ctx.RequestServices.GetRequiredService<AuditLog>();
+            var eventName = status switch { 403 => "authz.denied", 429 => "ratelimit.rejected", _ => "authn.required" };
+            var userId = int.TryParse(ctx.User.FindFirst("local_user_id")?.Value, out var id) ? id : (int?)null;
+            audit.Denied(ctx, eventName, userId, ctx.GetEndpoint()?.DisplayName ?? ctx.Request.Path.Value ?? "");
+        });
+}
