+    [Theory]
+    [InlineData("read", 1)] [InlineData("write", 2)] [InlineData("admin", 3)]
+    [InlineData("READ", 0)] [InlineData("root", 0)] [InlineData("", 0)] [InlineData(null, 0)]
+    public void Levels_are_ordered_and_anything_unknown_has_no_rank(string? level, int rank) => Assert.Equal(rank, ApiKeyDefaults.Rank(level));
