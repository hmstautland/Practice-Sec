+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.EntityFrameworkCore;
+using Xunit;
+
+namespace SecLab.Api.Tests.Learner;
+
+// Step 16 - negative tests, one or more per OWASP API Security Top 10 (2023) risk.
+// A negative test states what must NOT be possible and then tries it. It is green when the attack fails - and it must go red
+// when the control is removed (docs/attack-scripts/16-mutants.sh checks that for several controls).
+[Trait("Step", "16")]
+[Trait("Kind", "Negative")]
+public class OwaspNegativeTests(WebApplicationFactory<Program> factory) : IClassFixture<WebApplicationFactory<Program>>, IDisposable
+{
+    readonly List<IDisposable> _cleanup = [];
+    public void Dispose() { foreach (var c in _cleanup) c.Dispose(); }
+
+    /// <summary>A harness with the given configuration overrides (set BEFORE the host is built) and generous limits for everything not named.</summary>
+    Harness Start(params (string, string)[] settings)
+    {
+        var defaults = new Dictionary<string, string>
+        {
+            ["RateLimiting__Anonymous"] = "100000", ["RateLimiting__User"] = "100000", ["RateLimiting__Login"] = "100000",
+        };
+        foreach (var (k, v) in settings) defaults[k] = v;
+        _cleanup.Add(new EnvScope(defaults.Select(kv => (kv.Key, kv.Value)).ToArray()));
+        var h = new Harness(factory);
+        _cleanup.Add(h);
+        return h;
+    }
+
+    static async Task<JsonElement> Json(HttpResponseMessage res) => JsonDocument.Parse(await res.Content.ReadAsStringAsync()).RootElement.Clone();
+
+    static async Task<int> CreateBlog(Harness.Person who, string title = "mine")
+    {
+        var res = await who.Http.PostAsJsonAsync("/api/blogs", new { title, body = "<p>text</p>" });
+        Assert.Equal(HttpStatusCode.Created, res.StatusCode);
+        return (await Json(res)).GetProperty("id").GetInt32();
+    }
+
+    // ================= API1 Broken Object Level Authorization =================
+
+    [Fact]
+    [OwaspApi("API1")]
+    public async Task Another_user_cannot_edit_delete_or_read_private_data_of_my_objects()
+    {
+        var h = Start();
+        var (owner, intruder) = (h.NewPerson(), h.NewPerson());
+        var blogId = await CreateBlog(owner, "original");
+
+        Assert.Equal(HttpStatusCode.Forbidden, (await intruder.Http.PutAsJsonAsync($"/api/blogs/{blogId}", new { title = "hacked" })).StatusCode);
+        Assert.Equal(HttpStatusCode.Forbidden, (await intruder.Http.DeleteAsync($"/api/blogs/{blogId}")).StatusCode);
+        Assert.Equal(HttpStatusCode.Forbidden, (await intruder.Http.PutAsJsonAsync($"/api/users/{owner.Id}", new { bio = "hacked" })).StatusCode);
+        Assert.Equal(HttpStatusCode.Forbidden, (await intruder.Http.GetAsync($"/api/users/{owner.Id}/likes")).StatusCode);
+        Assert.Equal(HttpStatusCode.Forbidden, (await intruder.Http.GetAsync($"/api/users/{owner.Id}/friends")).StatusCode);
+
+        // "403" is not enough: prove that nothing changed.
+        Assert.Equal("original", h.InDb(db => db.Blogs.Single(b => b.Id == blogId).Title));
+        Assert.Equal("bio", h.InDb(db => db.Users.Single(u => u.Id == owner.Id).Bio));
+    }
+
+    [Fact]
+    [OwaspApi("API1")]
+    public async Task Ids_that_do_not_exist_and_ids_that_are_not_mine_do_not_crash_or_reveal_anything()
+    {
+        var h = Start();
+        var p = h.NewPerson();
+        foreach (var url in new[] { "/api/users/0", "/api/users/-1", "/api/users/2147483647" })
+        {
+            var res = await p.Http.GetAsync(url);
+            Assert.True(res.StatusCode == HttpStatusCode.NotFound, $"{url} -> {(int)res.StatusCode}");
+            Assert.DoesNotContain("email", await res.Content.ReadAsStringAsync(), StringComparison.OrdinalIgnoreCase);
+        }
+        Assert.Equal(HttpStatusCode.NotFound, (await p.Http.GetAsync("/api/users/abc")).StatusCode);    // not an int: no route, not an exception
+    }
+
+    // ================= API2 Broken Authentication =================
+
+    [Theory]
+    [InlineData("alg-none")] [InlineData("wrong-key")] [InlineData("expired")] [InlineData("wrong-audience")] [InlineData("wrong-issuer")] [InlineData("garbage")]
+    [OwaspApi("API2")]
+    public async Task A_token_that_is_not_exactly_right_is_refused(string kind)
+    {
+        var h = Start();
+        var p = h.NewPerson();
+        var idp = new TestIdp();                      // only used to mint tokens; the host above trusts its own key
+        _cleanup.Add(idp);
+        var token = kind switch
+        {
+            "alg-none" => TestIdp.UnsignedToken(p.Username),
+            "wrong-key" => idp.Token(p.Username, signWith: TestIdp.AttackerKey()),
+            "expired" => idp.Token(p.Username, expiresIn: TimeSpan.FromMinutes(-10)),
+            "wrong-audience" => idp.Token(p.Username, audience: "someone-else"),
+            "wrong-issuer" => idp.Token(p.Username, issuer: "https://evil.example/realms/x"),
+            _ => "not.a.jwt",
+        };
+        var req = new HttpRequestMessage(HttpMethod.Get, "/api/me");
+        req.Headers.Authorization = new("Bearer", token);
+        var res = await h.Anonymous().SendAsync(req);
+        Assert.Equal(HttpStatusCode.Unauthorized, res.StatusCode);
+    }
+
+    async Task<string> Register(HttpClient anon, string prefix)
+    {
+        var name = prefix + Guid.NewGuid().ToString("N")[..10];
+        Assert.Equal(HttpStatusCode.Created, (await anon.PostAsJsonAsync("/api/auth/register",
+            new { username = name, password = "correct-horse-battery", displayName = "V", email = $"{name}@example.com" })).StatusCode);
+        return name;
+    }
+
+    [Fact]
+    [OwaspApi("API2")]
+    public async Task Login_does_not_reveal_whether_the_user_exists()
+    {
+        var anon = Start().Anonymous();
+        var name = await Register(anon, "v");
+
+        var unknown = await anon.PostAsJsonAsync("/api/auth/login", new { username = "nobody-" + name, password = "whatever-123456" });
+        var wrong = await anon.PostAsJsonAsync("/api/auth/login", new { username = name, password = "whatever-123456" });
+        Assert.Equal(HttpStatusCode.Unauthorized, unknown.StatusCode);
+        Assert.Equal(HttpStatusCode.Unauthorized, wrong.StatusCode);
+        Assert.Equal(Strip(await unknown.Content.ReadAsStringAsync()), Strip(await wrong.Content.ReadAsStringAsync()));   // same answer, byte for byte (but the trace id)
+    }
+
+    static string Strip(string problem) => System.Text.RegularExpressions.Regex.Replace(problem, "\"traceId\":\"[^\"]*\"", "");
+
+    [Fact]
+    [OwaspApi("API2")]
+    public async Task Five_failed_logins_lock_the_account_and_four_do_not()
+    {
+        var anon = Start().Anonymous();
+        var name = await Register(anon, "k");
+        Task<HttpResponseMessage> Login(string password) => anon.PostAsJsonAsync("/api/auth/login", new { username = name, password });
+
+        for (var i = 0; i < 4; i++) Assert.Equal(HttpStatusCode.Unauthorized, (await Login("bad-guess-" + i)).StatusCode);
+        Assert.Equal(HttpStatusCode.OK, (await Login("correct-horse-battery")).StatusCode);          // four failures: not locked - and a success resets the counter
+
+        for (var i = 0; i < 5; i++) await Login("bad-guess-" + i);
+        var locked = await Login("correct-horse-battery");
+        Assert.Equal(HttpStatusCode.Unauthorized, locked.StatusCode);                                // five failures: even the right password is refused ...
+        var wrong = await Login("bad-guess-x");
+        Assert.Equal(Strip(await wrong.Content.ReadAsStringAsync()), Strip(await locked.Content.ReadAsStringAsync()));   // ... and it looks like any other failure
+    }
+
+    // ================= API3 Broken Object Property Level Authorization =================
+
+    [Fact]
+    [OwaspApi("API3")]
+    public async Task Mass_assignment_cannot_change_role_username_password_or_id()
+    {
+        var h = Start();
+        var p = h.NewPerson();
+        var before = h.InDb(db => db.Users.AsNoTracking().Single(u => u.Id == p.Id));
+
+        var res = await p.Http.PutAsJsonAsync($"/api/users/{p.Id}", new { bio = "new bio", role = "Admin", username = "root", password = "pwned", id = 1, passwordIsHashed = false });
+        Assert.Equal(HttpStatusCode.OK, res.StatusCode);
+
+        var after = h.InDb(db => db.Users.AsNoTracking().Single(u => u.Id == p.Id));
+        Assert.Equal("new bio", after.Bio);                        // the legitimate part was applied
+        Assert.Equal("User", after.Role);
+        Assert.Equal(before.Username, after.Username);
+        Assert.Equal(before.Password, after.Password);
+        Assert.Equal(before.Id, after.Id);
+    }
+
+    [Fact]
+    [OwaspApi("API3")]
+    public async Task Registration_ignores_fields_that_are_not_part_of_the_contract()
+    {
+        var h = Start();
+        var name = "r" + Guid.NewGuid().ToString("N")[..10];
+        var res = await h.Anonymous().PostAsJsonAsync("/api/auth/register",
+            new { username = name, password = "correct-horse-battery", displayName = "R", email = $"{name}@example.com", role = "Admin" });
+        Assert.Equal(HttpStatusCode.Created, res.StatusCode);
+        Assert.Equal("User", h.InDb(db => db.Users.Single(u => u.Username == name).Role));
+    }
+
+    [Fact]
+    [OwaspApi("API3")]
+    public async Task A_stranger_sees_the_public_profile_only()
+    {
+        var h = Start();
+        var (owner, stranger) = (h.NewPerson(), h.NewPerson());
+        var json = await Json(await stranger.Http.GetAsync($"/api/users/{owner.Id}"));
+        var names = json.EnumerateObject().Select(p => p.Name).Order().ToArray();
+        Assert.Equal(new[] { "avatarUrl", "bio", "displayName", "id", "username" }, names);   // no email, phone, address, role
+    }
+
+    // ================= API4 Unrestricted Resource Consumption =================
+
+    [Fact]
+    [OwaspApi("API4")]
+    public async Task Too_many_anonymous_requests_are_answered_with_429_and_Retry_After()
+    {
+        var h = Start(("RateLimiting__Anonymous", "3"), ("RateLimiting__WindowSeconds", "600"));
+        var anon = h.Anonymous();
+        for (var i = 0; i < 3; i++) Assert.Equal(HttpStatusCode.Unauthorized, (await anon.GetAsync("/api/me")).StatusCode);
+        var res = await anon.GetAsync("/api/me");
+        Assert.Equal(HttpStatusCode.TooManyRequests, res.StatusCode);
+        Assert.True(res.Headers.Contains("Retry-After"));
+    }
+
+    [Theory]
+    [InlineData("/api/blogs?api-version=2.0&pageSize=1000")]
+    [InlineData("/api/blogs?api-version=2.0&pageSize=0")]
+    [InlineData("/api/blogs?api-version=2.0&page=0")]
+    [InlineData("/api/blogs?api-version=2.0&page=-5")]
+    [OwaspApi("API4")]
+    public async Task Page_parameters_are_bounded(string url)
+    {
+        var p = Start().NewPerson();
+        Assert.Equal(HttpStatusCode.BadRequest, (await p.Http.GetAsync(url)).StatusCode);
+    }
+
+    [Fact]
+    [OwaspApi("API4")]
+    public async Task Oversized_input_is_rejected_not_stored()
+    {
+        var h = Start();
+        var p = h.NewPerson();
+        Assert.Equal(HttpStatusCode.BadRequest, (await p.Http.PostAsJsonAsync("/api/blogs", new { title = new string('t', 121), body = "x" })).StatusCode);
+        Assert.Equal(HttpStatusCode.BadRequest, (await p.Http.PostAsJsonAsync("/api/blogs", new { title = "t", body = new string('b', 10_001) })).StatusCode);
+        Assert.Equal(HttpStatusCode.BadRequest, (await p.Http.GetAsync("/api/blogs/search?q=" + new string('q', 101))).StatusCode);
+        Assert.Equal(0, h.InDb(db => db.Blogs.Count(b => b.AuthorId == p.Id)));
+    }
+
+    // ================= API5 Broken Function Level Authorization =================
+
+    [Fact]
+    [OwaspApi("API5")]
+    public async Task A_normal_user_cannot_use_admin_functions()
+    {
+        var h = Start();
+        var (user, victim) = (h.NewPerson(), h.NewPerson());
+        Assert.Equal(HttpStatusCode.Forbidden, (await user.Http.GetAsync("/api/admin/users")).StatusCode);
+        Assert.Equal(HttpStatusCode.Forbidden, (await user.Http.PutAsJsonAsync($"/api/admin/users/{victim.Id}/role", new { role = "Admin" })).StatusCode);
+        Assert.Equal(HttpStatusCode.Forbidden, (await user.Http.PutAsJsonAsync($"/api/admin/users/{user.Id}/role", new { role = "Admin" })).StatusCode);
+        Assert.Equal(HttpStatusCode.Forbidden, (await user.Http.GetAsync("/api/debug/crash")).StatusCode);
+        Assert.Equal("User", h.InDb(db => db.Users.Single(u => u.Id == user.Id).Role));
+        Assert.Equal("User", h.InDb(db => db.Users.Single(u => u.Id == victim.Id).Role));
+    }
+
+    [Fact]
+    [OwaspApi("API5")]
+    public async Task Nobody_can_mint_a_key_more_powerful_than_themselves_and_a_read_key_cannot_write()
+    {
+        var h = Start();
+        var user = h.NewPerson();
+        Assert.Equal(HttpStatusCode.Forbidden, (await user.Http.PostAsJsonAsync("/api/keys", new { name = "x", level = "admin" })).StatusCode);
+
+        var created = await user.Http.PostAsJsonAsync("/api/keys", new { name = "r", level = "read" });
+        var key = (await Json(created)).GetProperty("apiKey").GetString()!;
+        var write = new HttpRequestMessage(HttpMethod.Post, "/api/partner/blogs") { Content = JsonContent.Create(new { title = "t", body = "b" }) };
+        write.Headers.Add("X-Api-Key", key);
+        Assert.Equal(HttpStatusCode.Forbidden, (await h.Anonymous().SendAsync(write)).StatusCode);
+        Assert.Equal(0, h.InDb(db => db.Blogs.Count(b => b.AuthorId == user.Id)));
+    }
+
+    // ================= API6 Unrestricted Access to Sensitive Business Flows =================
+
+    [Fact]
+    [OwaspApi("API6")]
+    public async Task Mass_registration_from_one_address_is_throttled()
+    {
+        var h = Start(("RateLimiting__Login", "3"), ("RateLimiting__WindowSeconds", "600"));
+        var anon = h.Anonymous();
+        var statuses = new List<HttpStatusCode>();
+        for (var i = 0; i < 5; i++)
+        {
+            var n = "m" + Guid.NewGuid().ToString("N")[..10];
+            statuses.Add((await anon.PostAsJsonAsync("/api/auth/register", new { username = n, password = "correct-horse-battery", displayName = "M", email = $"{n}@example.com" })).StatusCode);
